1-1\" data-name=\"success case grid\">\n<div class=\"md:col-span-5 relative group bakery-image-wrap\" data-kid=\"1-2-5-1-1-1\" data-name=\"bakery image wrapper\">\n<div class=\"absolute -inset-4 border-2 border-[var(--flame)]/30 translate-x-4 translate-y-4 group-hover:translate-x-6 group-hover:translate-y-6 transition-transform\" data-kid=\"1-2-5-1-1-1-1\" data-name=\"bakery image border decoration\"></div>\n<div class=\"relative aspect-[4/5] overflow-hidden grayscale contrast-125\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"bakery image container\">\n<img alt=\"Industrial Bakery Equipment\" class=\"w-full h-full object-cover\" data-kid=\"1-2-5-1-1-1-2-1\" data-name=\"bakery equipment photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1684261421756-ef07becdf00c?auto=format&amp;w=800&amp;q=80&amp;fit=crop\">\n<div class=\"halftone-overlay absolute inset-0\" data-kid=\"1-2-5-1-1-1-2-2\" data-name=\"halftone overlay\"></div>\n</div>\n</div>\n<div class=\"md:col-span-7 flex flex-col justify-center\" data-kid=\"1-2-5-1-1-2\" data-name=\"success case quote section\">\n<div class=\"relative z-10 bg-[var(--onyx)] p-12 brutalist-border\" data-kid=\"1-2-5-1-1-2-1\" data-name=\"quote element\" id=\"pull-quote\">\n<i class=\"ti ti-quote text-7xl text-[var(--flame)]/10 absolute -top-8 -left-8\" data-kid=\"1-2-5-1-1-2-1-1\" data-name=\"quote icon\"></i>\n<div class=\"text-[var(--flame)] text-xs font-bold tracking-[0.3em] uppercase mb-10 font-mono flex items-center gap-4\" data-kid=\"1-2-5-1-1-2-1-2\" data-name=\"quote label group\">\n<span class=\"w-8 h-[1px] bg-[var(--flame)]\" data-kid=\"1-2-5-1-1-2-1-2-1\" data-name=\"label underline\"></span>\n                                CASE_STUDY // BAKERY_GROUP\n                            </div>\n<p class=\"text-4xl md:text-5xl font-black text-[var(--platinum)] uppercase tracking-tighter leading-tight mb-12 font-heading\" data-kid=\"1-2-5-1-1-2-1-3\" data-name=\"quote text\">\n                                \"Inventory synced across 5 production units with <span class=\"text-[var(--flame)]\" data-kid=\"1-2-5-1-1-2-1-3-1\" data-name=\"highlighted zero loss text\">zero loss</span>. Throughput +28%.\"\n                            </p>\n<div class=\"flex items-center gap-6\" data-kid=\"1-2-5-1-1-2-1-4\" data-name=\"quote author group\">\n<div class=\"w-16 h-16 rounded-full bg-[var(--carbon)] border-2 border-[var(--flame)] flex items-center justify-center overflow-hidden\" data-kid=\"1-2-5-1-1-2-1-4-1\" data-name=\"author portrait container\">\n<img alt=\"Operations Director\" class=\"w-full h-full object-cover opacity-80\" data-kid=\"1-2-5-1-1-2-1-4-1-1\" data-name=\"author portrait image\" src=\"https://i.pravatar.cc/100?u=solum_ops\">\n</div>\n<div data-kid=\"1-2-5-1-1-2-1-4-2\" data-name=\"author info container\">\n<div class=\"text-[var(--platinum)] font-black uppercase text-lg font-heading tracking-tight\" data-kid=\"1-2-5-1-1-2-1-4-2-1\" data-name=\"author name text\">Elias Thorne</div>\n<div class=\"text-[var(--flame)] text-xs font-mono uppercase font-bold\" data-kid=\"1-2-5-1-1-2-1-4-2-2\" data-name=\"author job title\">Director of Global Operations</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"min-h-screen flex items-center bg-[var(--onyx)] relative overflow-hidden border-t border-[var(--platinum)]/10\" data-kid=\"1-2-6\" data-name=\"cta section\" id=\"cta\">\n\n<div class=\"absolute left-0 top-1/2 -translate-y-1/2 pointer-events-none select-none\" data-kid=\"1-2-6-1\" data-name=\"cta watermark wrapper\" id=\"cta-watermark-wrapper\">\n<div class=\"text-[25rem] md:text-[35rem] font-black text-[var(--platinum)]/5 leading-none ml-[-5%] font-heading mix-blend-overlay\" data-kid=\"1-2-6-1-1\" data-name=\"cta watermark number\" id=\"cta-watermark\">01</div>\n</div>\n<div class=\"w-full max-w-6xl mx-auto px-12 md:px-24 flex flex-col md:flex-row justify-between items-end gap-16 relative z-10\" data-kid=\"1-2-6-2\" data-name=\"cta content container\">\n<div class=\"max-w-2xl\" data-kid=\"1-2-6-2-1\" data-name=\"cta headline container\">\n<div class=\"text-[var(--flame)] text-sm font-bold font-mono mb-8 tracking-[0.5em] uppercase\" data-kid=\"1-2-6-2-1-1\" data-name=\"initiation protocol label\">INITIATION_PROTOCOL</div>\n<h2 class=\"text-6xl md:text-[9rem] font-black text-[var(--platinum)] uppercase tracking-tighter leading-[0.8] mb-12 font-heading\" data-kid=\"1-2-6-2-1-2\" data-name=\"cta headline text\">\n                        READY TO<br data-kid=\"1-2-6-2-1-2-1\" data-name=\"cta headline break\"><span class=\"text-[var(--flame)]\" data-kid=\"1-2-6-2-1-2-2\" data-name=\"cta headline highlighted text\">REWIRE?</span>\n</h2>\n<p class=\"text-[var(--platinum)]/60 text-xl font-mono mb-12 max-w-xl\" data-kid=\"1-2-6-2-1-3\" data-name=\"cta description text\">\n                        The factory floor is waiting. Initiate an encrypted WhatsApp tunnel to discuss your industrial bottleneck today.\n                    </p>\n</div>\n<div class=\"w-full md:w-auto\" data-kid=\"1-2-6-2-2\" data-name=\"cta button container\">\n<a class=\"block bg-[var(--flame)] text-white text-center md:text-left px-14 py-10 text-3xl font-black uppercase tracking-tighter hover:bg-[var(--platinum)] hover:text-[var(--onyx)] transition-all transform hover:-translate-y-3 brutalist-border shadow-[15px_15px_0px_0px_rgba(255,79,0,0.3)] font-heading group\" data-kid=\"1-2-6-2-2-1\" data-name=\"initiate chat button\" href=\"https://wa.me/yournumber\">\n                        INITIATE CHAT\n                        <i class=\"ti ti-arrow-right ml-4 group-hover:translate-x-2 transition-transform\" data-kid=\"1-2-6-2-2-1-1\" data-name=\"right arrow icon\"></i>\n</a>\n</div>\n</div>\n</section>\n<footer class=\"py-12 px-12 md:px-24 border-t border-[var(--platinum)]/10 flex flex-col md:flex-row justify-between items-center gap-8 font-mono text-[10px] text-[var(--platinum)]/30 uppercase tracking-[0.2em] bg-[var(--onyx)]\" data-kid=\"1-2-7\" data-name=\"footer bar\">\n<div class=\"flex items-center gap-6\" data-kid=\"1-2-7-1\" data-name=\"footer status group\">\n<div class=\"flex items-center gap-2\" data-kid=\"1-2-7-1-1\" data-name=\"footer status element\">\n<div class=\"w-2 h-2 rounded-full bg-green-500 animate-pulse\" data-kid=\"1-2-7-1-1-1\" data-name=\"footer status indicator\"></div>\n                    SYSTEM_STABLE\n                </div>\n<div class=\"hidden md:block w-[1px] h-4 bg-[var(--platinum)]/10\" data-kid=\"1-2-7-1-2\" data-name=\"footer separator 1\"></div>\n<div class=\"hidden md:block\" data-kid=\"1-2-7-1-3\" data-name=\"footer stats text\">TX_LOAD: 0.042ms // BUFF: 92%</div>\n<div class=\"hidden md:block w-[1px] h-4 bg-[var(--platinum)]/10\" data-kid=\"1-2-7-1-4\" data-name=\"footer separator 2\"></div>\n<div data-kid=\"1-2-7-1-5\" data-name=\"footer copyright text\">© 2024 SOLUM_SF</div>\n</div>\n<div class=\"flex gap-12\" data-kid=\"1-2-7-2\" data-name=\"footer links group\">\n<a class=\"hover:text-[var(--flame)] transition-colors\" data-kid=\"1-2-7-2-1\" data-name=\"privacy policy link\" href=\"#\">Privacy</a>\n<a class=\"hover:text-[var(--flame)] transition-colors\" data-kid=\"1-2-7-2-2\" data-name=\"terms of service link\" href=\"#\">Terms</a>\n<a class=\"hover:text-[var(--flame)] transition-colors\" data-kid=\"1-2-7-2-3\" data-name=\"audit logs link\" href=\"#\">Audit_Logs</a>\n</div>\n<div class=\"font-bold\" data-kid=\"1-2-7-3\" data-name=\"footer build version text\">BUILD_4.0.12_STABLE</div>\n</footer>\n</main>\n</div>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"6\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"7\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/TextPlugin.min.js\" data-kid=\"8\"></script>\n<script type=\"module\" data-kid=\"9\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import Snap from \"https://esm.sh/lenis@1/snap\"\n    \n    // Initialize GSAP Plugins\n    gsap.registerPlugin(ScrollTrigger, TextPlugin);\n\n    // Smooth Scroll (Lenis) with GSAP Sync\n    const lenis = new Lenis({\n        lerp: 0.1,\n        smoothWheel: true\n    })\n\n    // GSAP Ticker Sync for Lenis\n    lenis.on('scroll', ScrollTrigger.update)\n    gsap.ticker.add((time)=>{\n        lenis.raf(time * 1000)\n    })\n    gsap.ticker.lagSmoothing(0)\n\n    // Hero Typewriter Sequence\n    const heroTimeline = gsap.timeline();\n    heroTimeline.to(\"#hero-typewriter\", {\n        duration: 3,\n        text: \"Solum_Software_Factory\",\n        ease: \"none\"\n    }).to(\".hero-content-reveal\", {\n        opacity: 1,\n        y: 0,\n        duration: 1.5,\n        stagger: 0.4,\n        ease: \"expo.out\"\n    }, \"-=0.8\");\n\n    // Scramble Text Effect\n    const scrambleElements = document.querySelectorAll('.scramble-trigger');\n    scrambleElements.forEach(el => {\n        const originalText = el.dataset.scramble;\n        const scrambleChars = \"X01$!@%*#<>/?\";\n        \n        el.addEventListener('mouseenter', () => {\n            let iteration = 0;\n            const interval = setInterval(() => {\n                el.innerText = originalText.split(\"\")\n                    .map((letter, index) => {\n                        if(index < iteration) return originalText[index];\n                        return scrambleChars[Math.floor(Math.random() * scrambleChars.length)]\n                    })\n                    .join(\"\");\n                \n                if(iteration >= originalText.length) clearInterval(interval);\n                iteration += 1/4;\n            }, 35);\n        });\n\n        el.addEventListener('mouseleave', () => {\n            el.innerText = originalText;\n        });\n    });\n\n    // Staggered Reveal for Ledger Rows\n    gsap.utils.toArray('.ledger-row').forEach((row, i) => {\n        gsap.from(row, {\n            scrollTrigger: {\n                trigger: row,\n                start: \"top 95%\",\n            },\n            opacity: 0,\n            x: -40,\n            duration: 1.5,\n            ease: \"power4.out\",\n            delay: i * 0.2\n        });\n    });\n\n    // Tech Blueprint Cards\n    gsap.utils.toArray('.blueprint-card').forEach((card, i) => {\n        gsap.from(card, {\n            scrollTrigger: {\n                trigger: card,\n                start: \"top 90%\",\n            },\n            opacity: 0,\n            y: 30,\n            duration: 1.2,\n            ease: \"expo.out\",\n            delay: i * 0.1\n        });\n    });\n\n    // Parallax\n    gsap.to(\".bakery-image-wrap\", {\n        y: -120,\n        scrollTrigger: {\n            trigger: \"#success-case\",\n            start: \"top bottom\",\n            end: \"bottom top\",\n            scrub: 1\n        }\n    });\n\n    gsap.to(\"#cta-watermark\", {\n        y: -180,\n        scrollTrigger: {\n            trigger: \"#cta\",\n            start: \"top bottom\",\n            end: \"bottom top\",\n            scrub: 1.5\n        }\n    });\n</script>\n",
