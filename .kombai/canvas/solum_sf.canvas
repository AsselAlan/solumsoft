10\" data-kid=\"1-9-1\" data-name=\"pin container\">\n<div class=\"absolute inset-0 bg-black/40 z-10\" data-kid=\"1-9-1-1\" data-name=\"image darkener overlay\"></div>\n<img alt=\"Artisanal Bakery Counter\" class=\"w-full h-full object-cover success-img\" data-kid=\"1-9-1-2\" data-name=\"success story image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1587241321921-91a834d6d191?auto=format&amp;w=1200&amp;q=80&amp;fit=crop\">\n<div class=\"absolute bottom-12 left-12 z-20 hidden md:block\" data-kid=\"1-9-1-3\" data-name=\"live status badge wrapper\">\n<div class=\"glass-card px-8 py-4 border-[#00CCFF]/30 border\" data-kid=\"1-9-1-3-1\" data-name=\"live status badge\">\n<div class=\"flex items-center gap-4\" data-kid=\"1-9-1-3-1-1\" data-name=\"live ping animation dot\">\n<div class=\"w-2 h-2 bg-[#00CCFF] rounded-full animate-ping\" data-kid=\"1-9-1-3-1-1-1\" data-name=\"ping indicator\"></div>\n<span class=\"text-[9px] font-black uppercase tracking-[0.4em] text-[#00CCFF]\" data-kid=\"1-9-1-3-1-1-2\" data-name=\"live status text\">Live System at Panadería \"El Trigal\"</span>\n</div>\n</div>\n</div>\n</div>\n\n<div class=\"w-full md:w-1/2 z-20 relative\" data-kid=\"1-9-2\" data-name=\"scrolling content column\">\n\n<div class=\"min-h-[120vh] flex flex-col justify-center p-12 md:p-24 space-y-24\" data-kid=\"1-9-2-1\" data-name=\"first story slide\">\n<div class=\"space-y-8\" data-kid=\"1-9-2-1-1\" data-name=\"story text block\">\n<h6 class=\"text-[#FF5800] font-black tracking-[0.6em] uppercase text-[9px]\" data-kid=\"1-9-2-1-1-1\" data-name=\"story subheader\">SCALING CASE // EL TRIGAL</h6>\n<h2 class=\"text-6xl md:text-9xl font-heading font-black leading-none tracking-tighter\" data-kid=\"1-9-2-1-1-2\" data-name=\"story headline\">5X NODES.<br data-kid=\"1-9-2-1-1-2-1\" data-name=\"headline line break\">180 DAYS.</h2>\n<p class=\"text-xl text-gray-500 leading-tight max-w-lg font-light\" data-kid=\"1-9-2-1-1-3\" data-name=\"story description\">\n                        El desafío: Controlar stock crítico y sincronizar 5 sucursales con una red de internet inestable.\n                    </p>\n</div>\n<div class=\"grid grid-cols-1 gap-16\" data-kid=\"1-9-2-1-2\" data-name=\"metrics grid\">\n<div class=\"space-y-4\" data-kid=\"1-9-2-1-2-1\" data-name=\"metric item\">\n<div class=\"text-7xl md:text-9xl font-heading font-black text-[#00CCFF] tracking-tighter\" data-kid=\"1-9-2-1-2-1-1\" data-name=\"metric value\">500%</div>\n<div class=\"text-gray-600 uppercase tracking-[0.3em] text-[10px] font-black\" data-kid=\"1-9-2-1-2-1-2\" data-name=\"metric label\">Growth Velocity</div>\n</div>\n<div class=\"space-y-4\" data-kid=\"1-9-2-1-2-2\" data-name=\"metric item\">\n<div class=\"text-7xl md:text-9xl font-heading font-black text-[#FF5800] tracking-tighter\" data-kid=\"1-9-2-1-2-2-1\" data-name=\"metric value\">30%</div>\n<div class=\"text-gray-600 uppercase tracking-[0.3em] text-[10px] font-black\" data-kid=\"1-9-2-1-2-2-2\" data-name=\"metric label\">Waste Reduction</div>\n</div>\n</div>\n</div>\n\n<div class=\"min-h-[50vh] flex flex-col justify-center p-12 md:p-24 space-y-12 bg-[#0a0a1a] border-t border-white/5\" data-kid=\"1-9-2-2\" data-name=\"second story slide\">\n<div class=\"relative\" data-kid=\"1-9-2-2-1\" data-name=\"quote wrapper\">\n<i class=\"ti ti-quote text-9xl text-white/5 absolute -top-16 -left-12\" data-kid=\"1-9-2-2-1-1\" data-name=\"quote icon\"></i>\n<p class=\"text-3xl md:text-4xl font-heading font-medium leading-tight italic relative z-10\" data-kid=\"1-9-2-2-1-2\" data-name=\"quote text\">\n                        \"Solum no solo nos dio un software, nos dio la paz mental para abrir una sucursal cada mes sin miedo a perder el control.\"\n                    </p>\n</div>\n<div class=\"flex items-center gap-8 pt-8\" data-kid=\"1-9-2-2-2\" data-name=\"testimonial author container\">\n<img alt=\"Marcos Rossi\" class=\"w-20 h-20 rounded-full border-2 border-[#FF5800] shadow-[0_0_15px_rgba(255,88,0,0.3)]\" data-kid=\"1-9-2-2-2-1\" data-name=\"author profile image\" src=\"https://i.pravatar.cc/120?u=marcosrossi\">\n<div data-kid=\"1-9-2-2-2-2\" data-name=\"author info container\">\n<div class=\"text-2xl font-bold\" data-kid=\"1-9-2-2-2-2-1\" data-name=\"author name\">Marcos Rossi</div>\n<div class=\"text-[#00CCFF] font-medium\" data-kid=\"1-9-2-2-2-2-2\" data-name=\"author title\">Founder, El Trigal S.A.</div>\n</div>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"relative py-48 md:py-80 bg-[#0a0a1a] overflow-hidden flex items-center justify-center border-t border-white/5\" data-kid=\"1-10\" data-name=\"giant cta marquee section\" id=\"giant-marquee\">\n<div class=\"absolute inset-0 flex items-center marquee-container opacity-5\" data-kid=\"1-10-1\" data-name=\"marquee background\">\n<div class=\"marquee-content animate-marquee-left\" data-kid=\"1-10-1-1\" data-name=\"marquee row 1\">\n<span class=\"text-[250px] md:text-[450px] font-heading font-black px-16\" data-kid=\"1-10-1-1-1\" data-name=\"build text\">BUILD WITH US</span>\n<span class=\"text-[250px] md:text-[450px] font-heading font-black px-16\" data-kid=\"1-10-1-1-2\" data-name=\"solum text\">SOLUM SOFTWARE</span>\n<span class=\"text-[250px] md:text-[450px] font-heading font-black px-16\" data-kid=\"1-10-1-1-3\" data-name=\"scalable text\">SCALABLE AI</span>\n<span class=\"text-[250px] md:text-[450px] font-heading font-black px-16\" data-kid=\"1-10-1-1-4\" data-name=\"offline text\">OFFLINE FIRST</span>\n</div>\n<div aria-hidden=\"true\" class=\"marquee-content animate-marquee-left\" data-kid=\"1-10-1-2\" data-name=\"marquee row 2\">\n<span class=\"text-[250px] md:text-[450px] font-heading font-black px-16\" data-kid=\"1-10-1-2-1\" data-name=\"build text\">BUILD WITH US</span>\n<span class=\"text-[250px] md:text-[450px] font-heading font-black px-16\" data-kid=\"1-10-1-2-2\" data-name=\"solum text\">SOLUM SOFTWARE</span>\n<span class=\"text-[250px] md:text-[450px] font-heading font-black px-16\" data-kid=\"1-10-1-2-3\" data-name=\"scalable text\">SCALABLE AI</span>\n<span class=\"text-[250px] md:text-[450px] font-heading font-black px-16\" data-kid=\"1-10-1-2-4\" data-name=\"offline text\">OFFLINE FIRST</span>\n</div>\n</div>\n<div class=\"relative z-10 text-center px-6 max-w-5xl space-y-16\" data-kid=\"1-10-2\" data-name=\"cta content container\">\n<h2 class=\"text-6xl md:text-[9rem] font-heading font-bold leading-[0.85] tracking-tighter\" data-kid=\"1-10-2-1\" data-name=\"cta headline\">¿Tu negocio es escalable hoy?</h2>\n<p class=\"text-2xl md:text-3xl text-gray-400 max-w-3xl mx-auto leading-relaxed\" data-kid=\"1-10-2-2\" data-name=\"cta description\">Habla directamente con nuestros arquitectos de software por WhatsApp y descubre cómo Solum puede blindar tu operación.</p>\n<div class=\"pt-8\" data-kid=\"1-10-2-3\" data-name=\"cta button wrapper\">\n<a class=\"inline-flex items-center gap-8 px-16 py-8 bg-[#FF5800] text-white text-2xl md:text-4xl font-bold rounded-[2rem] hover:scale-105 transition-all shadow-[0_0_60px_rgba(255,88,0,0.5)] group relative overflow-hidden\" data-kid=\"1-10-2-3-1\" data-name=\"whatsapp cta button\" href=\"https://wa.me/yournumber\">\n<div class=\"absolute inset-0 bg-white/10 translate-y-full group-hover:translate-y-0 transition-transform duration-500\" data-kid=\"1-10-2-3-1-1\" data-name=\"button hover overlay\"></div>\n<i class=\"ti ti-brand-whatsapp text-5xl relative z-10\" data-kid=\"1-10-2-3-1-2\" data-name=\"whatsapp icon\"></i>\n<span class=\"relative z-10\" data-kid=\"1-10-2-3-1-3\" data-name=\"cta text\">Chatear ahora</span>\n<i class=\"ti ti-arrow-up-right text-4xl group-hover:-translate-y-2 group-hover:translate-x-2 transition-transform duration-300 relative z-10\" data-kid=\"1-10-2-3-1-4\" data-name=\"arrow up-right icon\"></i>\n</a>\n</div>\n</div>\n</section>\n\n<footer class=\"py-20 border-t border-white/5 bg-[#010B13] px-6 md:px-24\" data-kid=\"1-11\" data-name=\"site footer\">\n<div class=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-12\" data-kid=\"1-11-1\" data-name=\"footer grid container\">\n<div class=\"space-y-6\" data-kid=\"1-11-1-1\" data-name=\"footer brand stack\">\n<div class=\"flex items-center gap-4\" data-kid=\"1-11-1-1-1\" data-name=\"footer brand row\">\n<img alt=\"Solum Logo\" class=\"h-10 w-auto shadow-[0_0_10px_rgba(255,88,0,0.2)]\" data-kid=\"1-11-1-1-1-1\" data-name=\"footer logo image\" src=\"data://attachments/images/image-1-2026-07-14_02-08-03.png\">\n<span class=\"font-heading font-bold text-3xl tracking-tighter\" data-kid=\"1-11-1-1-1-2\" data-name=\"footer brand name\">SOLUM SF</span>\n</div>\n<p class=\"text-gray-500 max-w-xs text-sm\" data-kid=\"1-11-1-1-2\" data-name=\"footer description\">Ingeniería de software de alto rendimiento para el motor de la economía: las PyMEs.</p>\n</div>\n<div class=\"grid grid-cols-2 md:grid-cols-3 gap-16\" data-kid=\"1-11-1-2\" data-name=\"footer links grid\">\n<div class=\"space-y-6\" data-kid=\"1-11-1-2-1\" data-name=\"sections links column\">\n<h5 class=\"text-xs font-bold uppercase tracking-widest text-white/40\" data-kid=\"1-11-1-2-1-1\" data-name=\"sections title\">Secciones</h5>\n<ul class=\"space-y-4 text-sm text-gray-500 font-medium\" data-kid=\"1-11-1-2-1-2\" data-name=\"sections links list\">\n<li data-kid=\"1-11-1-2-1-2-1\" data-name=\"sections link item\"><a class=\"hover:text-[#00CCFF] transition-colors\" data-kid=\"1-11-1-2-1-2-1-1\" data-name=\"problems link\" href=\"#split-comparison\">Problemas</a></li>\n<li data-kid=\"1-11-1-2-1-2-2\" data-name=\"sections link item\"><a class=\"hover:text-[#00CCFF] transition-colors\" data-kid=\"1-11-1-2-1-2-2-1\" data-name=\"solutions link\" href=\"#dashboard-bento\">Solución</a></li>\n<li data-kid=\"1-11-1-2-1-2-3\" data-name=\"sections link item\"><a class=\"hover:text-[#00CCFF] transition-colors\" data-kid=\"1-11-1-2-1-2-3-1\" data-name=\"technology link\" href=\"#dual-marquee\">Tecnología</a></li>\n</ul>\n</div>\n<div class=\"space-y-6\" data-kid=\"1-11-1-2-2\" data-name=\"company links column\">\n<h5 class=\"text-xs font-bold uppercase tracking-widest text-white/40\" data-kid=\"1-11-1-2-2-1\" data-name=\"company title\">Compañía</h5>\n<ul class=\"space-y-4 text-sm text-gray-500 font-medium\" data-kid=\"1-11-1-2-2-2\" data-name=\"company links list\">\n<li data-kid=\"1-11-1-2-2-2-1\" data-name=\"company link item\"><a class=\"hover:text-[#00CCFF] transition-colors\" data-kid=\"1-11-1-2-2-2-1-1\" data-name=\"about us link\" href=\"#\">Nosotros</a></li>\n<li data-kid=\"1-11-1-2-2-2-2\" data-name=\"company link item\"><a class=\"hover:text-[#00CCFF] transition-colors\" data-kid=\"1-11-1-2-2-2-2-1\" data-name=\"careers link\" href=\"#\">Carreras</a></li>\n<li data-kid=\"1-11-1-2-2-2-3\" data-name=\"company link item\"><a class=\"hover:text-[#00CCFF] transition-colors\" data-kid=\"1-11-1-2-2-2-3-1\" data-name=\"contact link\" href=\"#\">Contacto</a></li>\n</ul>\n</div>\n<div class=\"space-y-6 md:col-span-1 col-span-2\" data-kid=\"1-11-1-2-3\" data-name=\"social links column\">\n<h5 class=\"text-xs font-bold uppercase tracking-widest text-white/40\" data-kid=\"1-11-1-2-3-1\" data-name=\"social title\">Social</h5>\n<div class=\"flex gap-4\" data-kid=\"1-11-1-2-3-2\" data-name=\"social links container\">\n<a class=\"w-12 h-12 rounded-2xl glass-card flex items-center justify-center hover:bg-[#00CCFF]/10 hover:border-[#00CCFF]/30 transition-all text-xl\" data-kid=\"1-11-1-2-3-2-1\" data-name=\"linkedin link\" href=\"#\"><i class=\"ti ti-brand-linkedin\" data-kid=\"1-11-1-2-3-2-1-1\" data-name=\"linkedin icon\"></i></a>\n<a class=\"w-12 h-12 rounded-2xl glass-card flex items-center justify-center hover:bg-[#FF5800]/10 hover:border-[#FF5800]/30 transition-all text-xl\" data-kid=\"1-11-1-2-3-2-2\" data-name=\"twitter link\" href=\"#\"><i class=\"ti ti-brand-x\" data-kid=\"1-11-1-2-3-2-2-1\" data-name=\"twitter icon\"></i></a>\n<a class=\"w-12 h-12 rounded-2xl glass-card flex items-center justify-center hover:bg-white/10 transition-all text-xl\" data-kid=\"1-11-1-2-3-2-3\" data-name=\"github link\" href=\"#\"><i class=\"ti ti-brand-github\" data-kid=\"1-11-1-2-3-2-3-1\" data-name=\"github icon\"></i></a>\n</div>\n</div>\n</div>\n</div>\n<div class=\"mt-20 pt-8 border-t border-white/5 flex flex-col md:flex-row justify-between gap-6 text-[8px] font-black uppercase tracking-[0.4em] text-gray-600\" data-kid=\"1-11-2\" data-name=\"footer bottom row\">\n<div class=\"flex gap-8\" data-kid=\"1-11-2-1\" data-name=\"copyright container\">\n<span data-kid=\"1-11-2-1-1\" data-name=\"copyright text\">© 2024 SOLUM SOFTWARE FACTORY</span>\n<span data-kid=\"1-11-2-1-2\" data-name=\"delivery info text\">ARGENTINA • GLOBAL OPS</span>\n</div>\n<div class=\"flex gap-8\" data-kid=\"1-11-2-2\" data-name=\"legal links container\">\n<a class=\"hover:text-white transition-colors\" data-kid=\"1-11-2-2-1\" data-name=\"privacy policy link\" href=\"#\">Privacy</a>\n<a class=\"hover:text-white transition-colors\" data-kid=\"1-11-2-2-2\" data-name=\"legal terms link\" href=\"#\">Security</a>\n</div>\n</div>\n</footer>\n\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"12\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"13\"></script>\n<script data-kid=\"14\">gsap.registerPlugin(ScrollTrigger);</script>\n\n<script type=\"module\" data-kid=\"15\">\n        import Lenis from \"https://esm.sh/lenis@1\"\n        const lenis = new Lenis({\n            duration: 1.2,\n            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n            smoothWheel: true\n        })\n\n        function raf(time) {\n            lenis.raf(time)\n            requestAnimationFrame(raf)\n        }\n        requestAnimationFrame(raf)\n\n        // Navigation hide/reveal logic\n        const nav = document.getElementById('pill-nav');\n        lenis.on('scroll', ({ direction }) => {\n            if (direction === 1) {\n                nav.classList.add('hidden-nav');\n            } else if (direction === -1) {\n                nav.classList.remove('hidden-nav');\n            }\n        });\n\n        // Initialize animations after mount\n        window.addEventListener('load', () => {\n            // Hero Entrance\n            gsap.from(\".gsap-hero-reveal\", {\n                y: 50,\n                autoAlpha: 0,\n                duration: 1.2,\n                stagger: 0.25,\n                ease: \"power4.out\",\n                delay: 0.2\n            });\n\n            // 3D Object Floating Logic\n            gsap.to(\".float-3d\", {\n                y: -30,\n                duration: 4,\n                repeat: -1,\n                yoyo: true,\n                ease: \"sine.inOut\"\n            });\n            gsap.to(\".float-3d svg\", {\n                rotationY: 15,\n                rotationX: 5,\n                duration: 6,\n                repeat: -1,\n                yoyo: true,\n                ease: \"power1.inOut\"\n            });\n\n            // Bento Card Reveals\n            ScrollTrigger.batch(\".gsap-bento-card\", {\n                start: \"top 85%\",\n                onEnter: (elements) => {\n                    gsap.from(elements, {\n                        y: 80,\n                        autoAlpha: 0,\n                        duration: 1,\n                        stagger: 0.2,\n                        ease: \"power3.out\",\n                        overwrite: true\n                    });\n                }\n            });\n\n            // Marquee Performance & Interaction\n            const animL = gsap.to(\"#marquee-l .marquee-content\", {\n                xPercent: -100,\n                repeat: -1,\n                duration: 35,\n                ease: \"none\"\n            });\n\n            const animR = gsap.to(\"#marquee-r .marquee-content\", {\n                xPercent: 0,\n                repeat: -1,\n                duration: 35,\n                ease: \"none\"\n            });\n            gsap.set(\"#marquee-r .marquee-content\", { xPercent: -100 });\n\n            const marqueeL = document.getElementById('marquee-l');\n            const marqueeR = document.getElementById('marquee-r');\n\n            marqueeL.addEventListener(\"mouseenter\", () => gsap.to(animL, { timeScale: 3, duration: 0.8 }));\n            marqueeL.addEventListener(\"mouseleave\", () => gsap.to(animL, { timeScale: 1, duration: 0.8 }));\n            marqueeR.addEventListener(\"mouseenter\", () => gsap.to(animR, { timeScale: 3, duration: 0.8 }));\n            marqueeR.addEventListener(\"mouseleave\", () => gsap.to(animR, { timeScale: 1, duration: 0.8 }));\n\n            // Pinning Logic for Success Case\n            ScrollTrigger.create({\n                trigger: \"#gsap-pin-image-text\",\n                start: \"top top\",\n                end: \"bottom bottom\",\n                pin: \".pin-image\",\n                scrub: true,\n                anticipatePin: 1\n            });\n\n            // Success Case Visual Transitions\n            gsap.to(\".success-img\", {\n                scale: 1,\n                grayscale: 0,\n                brightness: 0.8,\n                scrollTrigger: {\n                    trigger: \"#gsap-pin-image-text\",\n                    start: \"top center\",\n                    end: \"bottom center\",\n                    scrub: true\n                }\n            });\n\n            // Giant Marquee\n            gsap.to(\"#giant-marquee .marquee-content\", {\n                xPercent: -100,\n                repeat: -1,\n                duration: 45,\n                ease: \"none\"\n            });\n        });\n    </script>\n</div>\n",
