      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=DM+Sans:wght@400;500&display=swap');\n  @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css');\n\n  :root {\n    --color-bg: #0A0F16;\n    --color-surface: #1C2B3E;\n    --color-coral: #FF7F50;\n    --color-blue: #00BFFF;\n    --font-heading: 'Plus Jakarta Sans', sans-serif;\n    --font-body: 'DM Sans', sans-serif;\n  }\n\n  * {\n    scrollbar-width: none;\n    -ms-overflow-style: none;\n  }\n  *::-webkit-scrollbar {\n    display: none;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: white;\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: clip;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .font-heading { font-family: var(--font-heading); }\n\n  .glass {\n    background: rgba(28, 43, 62, 0.4);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .text-gradient {\n    background: linear-gradient(135deg, var(--color-coral), var(--color-blue));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  /* Morphing Blobs */\n  .blob {\n    position: absolute;\n    width: 700px;\n    height: 700px;\n    border-radius: 50%;\n    filter: blur(100px);\n    z-index: 0;\n    opacity: 0.3;\n    mix-blend-mode: screen;\n    pointer-events: none;\n  }\n  .blob-coral { background: radial-gradient(circle, var(--color-coral) 0%, transparent 70%); }\n  .blob-blue { background: radial-gradient(circle, var(--color-blue) 0%, transparent 70%); }\n\n  /* Nav Indicator */\n  #nav-indicator {\n    position: absolute;\n    bottom: 0;\n    height: 2px;\n    background-color: var(--color-coral);\n    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);\n  }\n\n  /* Custom Cursor */\n  .custom-cursor {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 20px;\n    height: 20px;\n    background: white;\n    border-radius: 50%;\n    pointer-events: none;\n    z-index: 9999;\n    mix-blend-mode: difference;\n    transform: translate(-50%, -50%);\n  }\n\n  /* Ticker */\n  .ticker-container {\n    overflow: hidden;\n    white-space: nowrap;\n    width: 100%;\n  }\n  .ticker-track {\n    display: inline-block;\n    animation: ticker-slide 30s linear infinite;\n  }\n  @keyframes ticker-slide {\n    0% { transform: translateX(0); }\n    100% { transform: translateX(-50%); }\n  }\n\n  .perspective-1000 { perspective: 1000px; }\n  \n  /* Zigzag timeline stream path */\n  #timeline-svg {\n    position: absolute;\n    top: 0;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 100px;\n    height: 100%;\n    z-index: 0;\n  }\n\n  .magnetic-area {\n    display: inline-block;\n  }\n</style>\n<link data-kid=\"1\" data-name=\"lenis scroll css link\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\">\n\n<div class=\"custom-cursor hidden md:block\" data-kid=\"2\"></div>\n\n<nav class=\"fixed top-0 left-0 right-0 z-[100] px-6 py-6 transition-all duration-500\" data-kid=\"3\" data-name=\"navigation bar\" id=\"navbar\">\n<div class=\"max-w-7xl mx-auto flex items-center justify-between glass px-8 py-4 rounded-full border-white/5 bg-white/5 shadow-2xl\" data-kid=\"3-1\" data-name=\"navigation bar inner container\">\n<div class=\"flex items-center gap-12\" data-kid=\"3-1-1\" data-name=\"navigation group\">\n<a class=\"flex items-center gap-3 group\" data-kid=\"3-1-1-1\" data-name=\"logo link\" href=\"#\">\n<img alt=\"Solum SF Logo\" class=\"h-8 transition-transform group-hover:scale-105 brightness-0 invert opacity-80\" data-kid=\"3-1-1-1-1\" data-name=\"logo image\" src=\"/api/local/images/data://attachments/images/image-1-2026-07-14_02-08-03.png\">\n</a>\n<div class=\"hidden lg:flex items-center gap-8 relative\" data-kid=\"3-1-1-2\" data-name=\"navigation links container\" id=\"nav-links\">\n<a class=\"nav-item text-xs font-bold tracking-widest uppercase text-white/70 hover:text-white transition-colors py-2\" data-kid=\"3-1-1-2-1\" data-name=\"stream navigation link\" href=\"#work\">Stream</a>\n<a class=\"nav-item text-xs font-bold tracking-widest uppercase text-white/70 hover:text-white transition-colors py-2\" data-kid=\"3-1-1-2-2\" data-name=\"architecture navigation link\" href=\"#solutions\">Architecture</a>\n<a class=\"nav-item text-xs font-bold tracking-widest uppercase text-white/70 hover:text-white transition-colors py-2\" data-kid=\"3-1-1-2-3\" data-name=\"tech stack navigation link\" href=\"#tech\">Stack</a>\n<div data-kid=\"3-1-1-2-4\" data-name=\"navigation hover indicator\" id=\"nav-indicator\"></div>\n</div>\n</div>\n<div class=\"flex items-center gap-8\" data-kid=\"3-1-2\" data-name=\"nav actions group\">\n<a class=\"hidden md:block text-xs font-bold tracking-widest uppercase text-white/70 hover:text-white transition-colors\" data-kid=\"3-1-2-1\" data-name=\"success cases navigation link\" href=\"#success\">Success</a>\n<div class=\"magnetic-area\" data-kid=\"3-1-2-2\" data-name=\"whatsapp magnetic button wrapper\">\n<button class=\"bg-[var(--color-blue)] text-white px-6 py-2.5 rounded-full text-xs font-bold uppercase tracking-widest flex items-center gap-2 hover:brightness-110 transition-all shadow-lg shadow-[var(--color-blue)]/20 active:scale-95\" data-kid=\"3-1-2-2-1\" data-name=\"whatsapp connect button\" id=\"whatsapp-nav-btn\">\n<i class=\"fab fa-whatsapp text-lg\" data-kid=\"3-1-2-2-1-1\" data-name=\"whatsapp icon\"></i>\n          Connect\n        </button>\n</div>\n</div>\n</div>\n</nav>\n\n<section class=\"relative min-h-screen flex items-center px-6 lg:px-20 overflow-hidden pt-32\" data-kid=\"4\" data-name=\"hero section\" id=\"hero\">\n<div class=\"blob blob-coral\" data-kid=\"4-1\" data-name=\"background coral morphing blob\" id=\"blob-1\" style=\"top:-20%; left:-10%\"></div>\n<div class=\"blob blob-blue\" data-kid=\"4-2\" data-name=\"background blue morphing blob\" id=\"blob-2\" style=\"bottom:-20%; right:-10%\"></div>\n<div class=\"absolute inset-0 z-0 overflow-hidden pointer-events-none\" data-kid=\"4-3\" data-name=\"hero background media container\">\n<video autoplay=\"\" class=\"w-full h-full object-cover blur-[80px] opacity-40 scale-125\" data-kid=\"4-3-1\" data-name=\"hero background video\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/16478021/4k-abstract-background-black-and-blue-16478021.jpeg?auto=compress&amp;cs=tinysrgb&amp;fit=crop&amp;h=630&amp;w=1200\" src=\"https://videos.pexels.com/video-files/16478021/16478021-uhd_3840_2160_24fps.mp4\"></video>\n</div>\n<div class=\"max-w-7xl mx-auto w-full grid lg:grid-cols-2 gap-20 items-center relative z-10\" data-kid=\"4-4\" data-name=\"hero content panel\">\n<div class=\"text-left\" data-kid=\"4-4-1\" data-name=\"hero content block\">\n<div class=\"inline-block px-4 py-2 rounded-lg bg-[var(--color-coral)]/10 border border-[var(--color-coral)]/20 text-[var(--color-coral)] text-[10px] font-black tracking-[0.3em] uppercase mb-8 reveal-up\" data-kid=\"4-4-1-1\" data-name=\"software factory badge\">\n        Software Factory\n      </div>\n<h1 class=\"font-heading text-6xl md:text-9xl font-extrabold leading-[0.9] tracking-tighter mb-10 reveal-up\" data-kid=\"4-4-1-2\" data-name=\"hero headline\">\n        Pure<br data-kid=\"4-4-1-2-1\" data-name=\"headline line break\">\n<span class=\"text-white/20\" data-kid=\"4-4-1-2-2\" data-name=\"hero headline faded word\">Digital</span><br data-kid=\"4-4-1-2-3\" data-name=\"headline line break\">\n        Flow.\n      </h1>\n<p class=\"text-xl md:text-2xl text-white/70 max-w-md mb-12 font-medium leading-snug reveal-up\" data-kid=\"4-4-1-3\" data-name=\"hero subheadline text\">\n        We transform industrial chaos into sleek, automated systems for SMEs. UX Premium. AI-Integrated.\n      </p>\n<div class=\"flex flex-wrap gap-6 reveal-up\" data-kid=\"4-4-1-4\" data-name=\"hero actions container\">\n<div class=\"magnetic-area\" data-kid=\"4-4-1-4-1\" data-name=\"start project button wrapper\">\n<button class=\"px-10 py-5 bg-[var(--color-coral)] text-white rounded-2xl font-black uppercase tracking-widest text-xs hover:brightness-110 transition-all shadow-xl shadow-[var(--color-coral)]/20\" data-kid=\"4-4-1-4-1-1\" data-name=\"start project button\">\n            Start Project\n          </button>\n</div>\n<button class=\"px-10 py-5 glass border-white/5 rounded-2xl font-black uppercase tracking-widest text-xs hover:bg-white/5 transition-all text-white/70\" data-kid=\"4-4-1-4-2\" data-name=\"our methods button\">\n          Our Methods\n        </button>\n</div>\n</div>\n<div class=\"relative hidden lg:block reveal-right\" data-kid=\"4-4-2\" data-name=\"hero visual elements container\">\n<div class=\"w-full aspect-[4/5] glass rounded-[80px] border-white/5 overflow-hidden shadow-2xl relative\" data-kid=\"4-4-2-1\" data-name=\"hero showcase image container\">\n<video autoplay=\"\" class=\"w-full h-full object-cover opacity-60\" data-kid=\"4-4-2-1-1\" data-name=\"hero showcase video\" loop=\"\" muted=\"\" playsinline=\"\" src=\"https://videos.pexels.com/video-files/16392051/16392051-hd_1920_1080_24fps.mp4\"></video>\n<div class=\"absolute inset-0 bg-linear-to-br from-[var(--color-blue)]/20 to-transparent\" data-kid=\"4-4-2-1-2\" data-name=\"showcase image gradient overlay\"></div>\n<div class=\"absolute bottom-12 left-12 right-12 p-10 glass rounded-[40px] border-white/10 backdrop-blur-3xl\" data-kid=\"4-4-2-1-3\" data-name=\"showcase metric card\">\n<div class=\"text-white font-heading text-2xl font-bold mb-2\" data-kid=\"4-4-2-1-3-1\" data-name=\"showcase metric value\">3.4x Efficiency</div>\n<div class=\"text-white/40 text-xs font-bold uppercase tracking-widest\" data-kid=\"4-4-2-1-3-2\" data-name=\"showcase metric label\">Average Client Uplift</div>\n</div>\n</div>\n\n<div class=\"absolute -top-10 -right-10 w-40 h-40 glass rounded-full border-white/10 flex items-center justify-center p-6 backdrop-blur-2xl animate-bounce-slow shadow-[0_0_40px_rgba(255,127,80,0.2)]\" data-kid=\"4-4-2-2\" data-name=\"floating decorative microchip icon\">\n<i class=\"fas fa-microchip text-[var(--color-coral)] text-5xl\" data-kid=\"4-4-2-2-1\" data-name=\"microchip icon\"></i>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"py-24 relative bg-[#0A0F16]\" data-kid=\"5\" data-name=\"problem section\" id=\"work\">\n<div class=\"max-w-7xl mx-auto px-6 mb-20 flex flex-col md:flex-row items-baseline gap-8\" data-kid=\"5-1\" data-name=\"problem section header\">\n<h2 class=\"font-heading text-5xl md:text-7xl font-extrabold\" data-kid=\"5-1-1\" data-name=\"problem title\">The<br data-kid=\"5-1-1-1\" data-name=\"title line break\"><span class=\"text-white/20\" data-kid=\"5-1-1-2\" data-name=\"title faded word\">Rills.</span></h2>\n<p class=\"text-white/60 max-w-md text-lg leading-relaxed font-medium\" data-kid=\"5-1-2\" data-name=\"problem description\">Disconnected tools and legacy friction create gaps in your operational stream. We bridge them.</p>\n</div>\n<div class=\"relative max-w-6xl mx-auto px-6\" data-kid=\"5-2\" data-name=\"timeline track\">\n\n<svg class=\"opacity-30\" data-dynamic=\"true\" data-kid=\"5-2-1\" data-name=\"zigzag animation path svg\" data-reason=\"path stroke and dasharray updated by scroll script\" id=\"timeline-svg\" preserveaspectratio=\"none\" viewbox=\"0 0 100 1000\">\n<path d=\"M50,0 Q60,250 40,500 T50,1000\" fill=\"none\" id=\"stream-path\" stroke=\"url(#grad)\" stroke-width=\"2\" data-kid=\"12\"></path>\n<defs data-kid=\"13\">\n<lineargradient id=\"grad\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\" data-kid=\"14\">\n<stop offset=\"0%\" stop-color=\"var(--color-coral)\" data-kid=\"15\"></stop>\n<stop offset=\"100%\" stop-color=\"var(--color-blue)\" data-kid=\"16\"></stop>\n</lineargradient>\n</defs>\n</svg>\n\n<div class=\"space-y-24 md:space-y-32\" data-kid=\"5-2-2\" data-name=\"timeline items wrapper\">\n\n<div class=\"flex flex-col md:flex-row items-center justify-between gap-12 group\" data-kid=\"5-2-2-1\">\n<div class=\"w-full md:w-[42%] text-right reveal-left order-2 md:order-1\" data-kid=\"5-2-2-1-1\">\n<div class=\"inline-flex w-16 h-16 rounded-2xl glass mb-6 items-center justify-center text-[var(--color-coral)] text-2xl group-hover:scale-110 transition-transform\" data-kid=\"5-2-2-1-1-1\">\n<i class=\"fas fa-link-slash\" data-kid=\"5-2-2-1-1-1-1\"></i>\n</div>\n<h3 class=\"font-heading text-3xl mb-4 font-bold\" data-kid=\"5-2-2-1-1-2\">Tool Isolation</h3>\n<p class=\"text-white/50 leading-relaxed text-lg\" data-kid=\"5-2-2-1-1-3\">Fragmented data across legacy systems prevents a unified view of your business operations, leading to critical errors.</p>\n</div>\n<div class=\"w-20 h-20 rounded-full glass border-white/10 flex items-center justify-center z-10 order-1 md:order-2\" data-kid=\"5-2-2-1-2\">\n<div class=\"w-4 h-4 rounded-full bg-[var(--color-coral)]\" data-kid=\"5-2-2-1-2-1\"></div>\n</div>\n<div class=\"hidden md:block md:w-[42%] order-3\" data-kid=\"5-2-2-1-3\"></div>\n</div>\n\n<div class=\"flex flex-col md:flex-row items-center justify-between gap-12 group\" data-kid=\"5-2-2-2\">\n<div class=\"hidden md:block md:w-[42%] order-1\" data-kid=\"5-2-2-2-1\"></div>\n<div class=\"w-20 h-20 rounded-full glass border-white/10 flex items-center justify-center z-10 order-1 md:order-2\" data-kid=\"5-2-2-2-2\">\n<div class=\"w-4 h-4 rounded-full bg-[var(--color-blue)]\" data-kid=\"5-2-2-2-2-1\"></div>\n</div>\n<div class=\"w-full md:w-[42%] text-left reveal-right order-2 md:order-3\" data-kid=\"5-2-2-2-3\">\n<div class=\"inline-flex w-16 h-16 rounded-2xl glass mb-6 items-center justify-center text-[var(--color-blue)] text-2xl group-hover:scale-110 transition-transform\" data-kid=\"5-2-2-2-3-1\">\n<i class=\"fas fa-mobile-button\" data-kid=\"5-2-2-2-3-1-1\"></i>\n</div>\n<h3 class=\"font-heading text-3xl mb-4 font-bold\" data-kid=\"5-2-2-2-3-2\">Mobile Friction</h3>\n<p class=\"text-white/50 leading-relaxed text-lg\" data-kid=\"5-2-2-2-3-3\">Employees tethered to desks due to non-responsive web apps. We bring your entire factory to the palm of their hands.</p>\n</div>\n</div>\n\n<div class=\"flex flex-col md:flex-row items-center justify-between gap-12 group\" data-kid=\"5-2-2-3\">\n<div class=\"w-full md:w-[42%] text-right reveal-left order-2 md:order-1\" data-kid=\"5-2-2-3-1\">\n<div class=\"inline-flex w-16 h-16 rounded-2xl glass mb-6 items-center justify-center text-white text-2xl group-hover:scale-110 transition-transform\" data-kid=\"5-2-2-3-1-1\">\n<i class=\"fas fa-wifi-slash\" data-kid=\"5-2-2-3-1-1-1\"></i>\n</div>\n<h3 class=\"font-heading text-3xl mb-4 font-bold\" data-kid=\"5-2-2-3-1-2\">Connectivity Caps</h3>\n<p class=\"text-white/50 leading-relaxed text-lg\" data-kid=\"5-2-2-3-1-3\">Standard SaaS fails when the connection drops. Our offline-first engine keeps the gears turning in the deadest zones.</p>\n</div>\n<div class=\"w-20 h-20 rounded-full glass border-white/10 flex items-center justify-center z-10 order-1 md:order-2\" data-kid=\"5-2-2-3-2\">\n<div class=\"w-4 h-4 rounded-full bg-white\" data-kid=\"5-2-2-3-2-1\"></div>\n</div>\n<div class=\"hidden md:block md:w-[42%] order-3\" data-kid=\"5-2-2-3-3\"></div>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"py-40 bg-[#0C141D] overflow-hidden\" data-kid=\"6\" data-name=\"solution section\" id=\"solutions\">\n<div class=\"max-w-7xl mx-auto px-6 mb-32\" data-kid=\"6-1\" data-name=\"solution header container\">\n<div class=\"flex flex-col lg:flex-row lg:items-end justify-between gap-12\" data-kid=\"6-1-1\" data-name=\"solution header inner\">\n<div class=\"max-w-2xl\" data-kid=\"6-1-1-1\" data-name=\"solution intro group\">\n<span class=\"text-[var(--color-coral)] font-bold tracking-widest uppercase text-xs\" data-kid=\"6-1-1-1-1\" data-name=\"architectural prowess badge\">Architectural Prowess</span>\n<h2 class=\"font-heading text-4xl md:text-6xl mt-6 font-extrabold\" data-kid=\"6-1-1-1-2\" data-name=\"solution main title\">Modern Foundations.</h2>\n</div>\n<p class=\"text-white/40 max-w-md text-lg leading-relaxed\" data-kid=\"6-1-1-2\" data-name=\"solution description text\">\n        We combine industrial-grade architecture with consumer-grade aesthetics. The result? Software people actually enjoy using.\n      </p>\n</div>\n</div>\n\n<div class=\"max-w-7xl mx-auto px-6 relative flex justify-center perspective-1000 py-20\" data-kid=\"6-2\" data-name=\"solution cards deck container\">\n<div class=\"flex flex-col md:flex-row -space-y-12 md:space-y-0 md:-space-x-24 items-center md:items-stretch\" data-kid=\"6-2-1\" data-name=\"solution cards deck\" id=\"solution-deck\">\n\n<div class=\"deck-card glass w-full md:w-[400px] min-h-[520px] rounded-[56px] p-14 flex flex-col justify-between border-white/10 bg-[#1C2B3E] hover:rotate-[-2deg] transition-all duration-700 hover:-translate-y-12 z-30\" data-kid=\"6-2-1-1\" data-name=\"UX premium card\" data-scroll=\"\" data-scroll-speed=\"1.2\">\n<div data-kid=\"6-2-1-1-1\" data-name=\"UX card inner\">\n<div class=\"w-20 h-20 rounded-[28px] bg-[var(--color-coral)]/10 flex items-center justify-center text-[var(--color-coral)] text-4xl mb-10\" data-kid=\"6-2-1-1-1-1\" data-name=\"UX icon container\">\n<i class=\"fas fa-layer-group\" data-kid=\"6-2-1-1-1-1-1\" data-name=\"UX layer group icon\"></i>\n</div>\n<h3 class=\"font-heading text-4xl mb-6 font-black tracking-tight\" data-kid=\"6-2-1-1-1-2\" data-name=\"UX title\">UX Premium</h3>\n<p class=\"text-white/60 leading-relaxed text-lg font-medium\" data-kid=\"6-2-1-1-1-3\" data-name=\"UX description\">No learning curves. We build interfaces that employees love using, resulting in zero friction and max speed.</p>\n</div>\n<div class=\"pt-8 border-t border-white/5 flex justify-between items-center\" data-kid=\"6-2-1-1-2\" data-name=\"UX card footer\">\n<span class=\"text-[10px] font-black text-[var(--color-coral)] tracking-[0.3em] uppercase\" data-kid=\"6-2-1-1-2-1\" data-name=\"UX card tag\">User Centric</span>\n<i class=\"fas fa-chevron-right text-xs opacity-30\" data-kid=\"6-2-1-1-2-2\" data-name=\"UX card arrow icon\"></i>\n</div>\n</div>\n\n<div class=\"deck-card glass w-full md:w-[400px] min-h-[520px] rounded-[56px] p-14 flex flex-col justify-between border-white/10 bg-[#162332] hover:rotate-[1deg] transition-all duration-700 hover:-translate-y-12 z-20\" data-kid=\"6-2-1-2\" data-name=\"offline first card\" data-scroll=\"\" data-scroll-speed=\"0.8\">\n<div data-kid=\"6-2-1-2-1\" data-name=\"offline card inner\">\n<div class=\"w-20 h-20 rounded-[28px] bg-[var(--color-blue)]/10 flex items-center justify-center text-[var(--color-blue)] text-4xl mb-10\" data-kid=\"6-2-1-2-1-1\" data-name=\"offline icon container\">\n<i class=\"fas fa-signal-stream-slash\" data-kid=\"6-2-1-2-1-1-1\" data-name=\"offline icon\"></i>\n</div>\n<h3 class=\"font-heading text-4xl mb-6 font-black tracking-tight\" data-kid=\"6-2-1-2-1-2\" data-name=\"offline title\">Offline First</h3>\n<p class=\"text-white/60 leading-relaxed text-lg font-medium\" data-kid=\"6-2-1-2-1-3\" data-name=\"offline description\">Your work shouldn't stop because the Wi-Fi did. Our sync engine handles the heavy lifting automatically.</p>\n</div>\n<div class=\"pt-8 border-t border-white/5 flex justify-between items-center\" data-kid=\"6-2-1-2-2\" data-name=\"offline card footer\">\n<span class=\"text-[10px] font-black text-[var(--color-blue)] tracking-[0.3em] uppercase\" data-kid=\"6-2-1-2-2-1\" data-name=\"offline card tag\">Local Sync</span>\n<i class=\"fas fa-chevron-right text-xs opacity-30\" data-kid=\"6-2-1-2-2-2\" data-name=\"offline card arrow icon\"></i>\n</div>\n</div>\n\n<div class=\"deck-card glass w-full md:w-[400px] min-h-[520px] rounded-[56px] p-14 flex flex-col justify-between border-white/10 bg-[#0F1924] hover:rotate-[3deg] transition-all duration-700 hover:-translate-y-12 z-10\" data-kid=\"6-2-1-3\" data-name=\"practical AI card\" data-scroll=\"\" data-scroll-speed=\"0.4\">\n<div data-kid=\"6-2-1-3-1\" data-name=\"AI card inner\">\n<div class=\"w-20 h-20 rounded-[28px] bg-white/5 flex items-center justify-center text-white text-4xl mb-10\" data-kid=\"6-2-1-3-1-1\" data-name=\"AI icon container\">\n<i class=\"fas fa-atom\" data-kid=\"6-2-1-3-1-1-1\" data-name=\"AI atom icon\"></i>\n</div>\n<h3 class=\"font-heading text-4xl mb-6 font-black tracking-tight\" data-kid=\"6-2-1-3-1-2\" data-name=\"AI title\">Practical AI</h3>\n<p class=\"text-white/60 leading-relaxed text-lg font-medium\" data-kid=\"6-2-1-3-1-3\" data-name=\"AI description\">Predictive inventory and automated tagging that provides immediate ROI. Not just buzzwords, actual tools.</p>\n</div>\n<div class=\"pt-8 border-t border-white/5 flex justify-between items-center\" data-kid=\"6-2-1-3-2\" data-name=\"AI card footer\">\n<span class=\"text-[10px] font-black text-white/30 tracking-[0.3em] uppercase\" data-kid=\"6-2-1-3-2-1\" data-name=\"AI card tag\">Smart Engine</span>\n<i class=\"fas fa-chevron-right text-xs opacity-30\" data-kid=\"6-2-1-3-2-2\" data-name=\"AI card arrow icon\"></i>\n</div>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"py-24 relative bg-[#0A0F16] overflow-hidden min-h-[800px] flex items-center\" data-kid=\"7\" data-name=\"tech stack section\" id=\"tech\">\n<div class=\"max-w-7xl mx-auto px-6 relative z-20 pointer-events-none\" data-kid=\"7-1\" data-name=\"tech section intro container\">\n<div class=\"max-w-xl\" data-kid=\"7-1-1\" data-name=\"tech section intro\">\n<h2 class=\"font-heading text-6xl md:text-8xl font-black text-white/10 mb-8\" data-kid=\"7-1-1-1\" data-name=\"tech section title\">Modern<br data-kid=\"7-1-1-1-1\" data-name=\"tech section title line break\">Stack.</h2>\n<p class=\"text-white/40 text-lg font-medium\" data-kid=\"7-1-1-2\" data-name=\"tech section description\">We only build with proven, scalable technology that ensures your software remains relevant for a decade.</p>\n</div>\n</div>\n<div class=\"absolute inset-0 overflow-hidden\" data-kid=\"7-2\" data-name=\"tech nodes container\" id=\"constellation-field\">\n<svg class=\"absolute inset-0 w-full h-full pointer-events-none\" data-dynamic=\"true\" data-kid=\"7-2-1\" data-name=\"constellation animation svg\" data-reason=\"nodes connected by lines calculated by script\" id=\"constellation-svg\"></svg>\n\n<div class=\"tech-node absolute glass w-16 h-16 rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing z-20\" data-dynamic=\"true\" data-kid=\"7-2-2\" data-name=\"react tech node\" data-reason=\"element position adjusted by animation script\" style=\"top: 15%; left: 65%;\">\n<img alt=\"React\" class=\"w-8 h-8\" data-kid=\"7-2-2-1\" data-name=\"react icon\" src=\"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg\">\n</div>\n<div class=\"tech-node absolute glass w-24 h-24 rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing z-20\" data-dynamic=\"true\" data-kid=\"7-2-3\" data-name=\"supabase tech node\" data-reason=\"element position adjusted by animation script\" style=\"top: 40%; left: 80%;\">\n<img alt=\"Supabase\" class=\"w-10 h-10\" data-kid=\"7-2-3-1\" data-name=\"supabase icon\" src=\"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/supabase/supabase-original.svg\">\n</div>\n<div class=\"tech-node absolute glass w-20 h-20 rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing z-20\" data-dynamic=\"true\" data-kid=\"7-2-4\" data-name=\"tailwind tech node\" data-reason=\"element position adjusted by animation script\" style=\"top: 60%; left: 50%;\">\n<img alt=\"Tailwind\" class=\"w-8 h-8\" data-kid=\"7-2-4-1\" data-name=\"tailwind icon\" src=\"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/tailwindcss/tailwindcss-original.svg\">\n</div>\n<div class=\"tech-node absolute glass w-22 h-22 rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing z-20\" data-dynamic=\"true\" data-kid=\"7-2-5\" data-name=\"nodejs tech node\" data-reason=\"element position adjusted by animation script\" style=\"top: 80%; left: 75%;\">\n<img alt=\"NodeJS\" class=\"w-10 h-10\" data-kid=\"7-2-5-1\" data-name=\"nodejs icon\" src=\"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nodejs/nodejs-original.svg\">\n</div>\n<div class=\"tech-node absolute glass w-18 h-18 rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing z-20\" data-dynamic=\"true\" data-kid=\"7-2-6\" data-name=\"typescript tech node\" data-reason=\"element position adjusted by animation script\" style=\"top: 25%; left: 40%;\">\n<img alt=\"TypeScript\" class=\"w-8 h-8\" data-kid=\"7-2-6-1\" data-name=\"typescript icon\" src=\"https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg\">\n</div>\n<div class=\"tech-node absolute glass w-14 h-14 rounded-full flex items-center justify-center z-20\" data-dynamic=\"true\" data-kid=\"7-2-7\" data-name=\"additional tech node 1\" data-reason=\"element position adjusted by animation script\" style=\"top: 70%; left: 20%;\">\n<i class=\"fas fa-microchip text-[var(--color-blue)]\" data-kid=\"7-2-7-1\" data-name=\"microchip icon\"></i>\n</div>\n<div class=\"tech-node absolute glass w-16 h-16 rounded-full flex items-center justify-center z-20\" data-dynamic=\"true\" data-kid=\"7-2-8\" data-name=\"additional tech node 2\" data-reason=\"element position adjusted by animation script\" style=\"top: 10%; left: 25%;\">\n<i class=\"fas fa-brain text-[var(--color-coral)]\" data-kid=\"7-2-8-1\" data-name=\"brain icon\"></i>\n</div>\n</div>\n</section>\n\n<section class=\"py-40 bg-[#080B11]\" data-kid=\"8\" data-name=\"success case section\" id=\"success\">\n<div class=\"max-w-7xl mx-auto px-6\" data-kid=\"8-1\">\n<div class=\"grid lg:grid-cols-2 gap-24 items-center\" data-kid=\"8-1-1\">\n\n<div class=\"relative group\" data-kid=\"8-1-1-1\">\n<div class=\"relative overflow-hidden rounded-[64px] shadow-2xl\" data-kid=\"8-1-1-1-1\" id=\"success-gallery-main\">\n<img alt=\"Baker scoring bread\" class=\"w-full h-[600px] object-cover transition-transform duration-700\" data-kid=\"8-1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1517686469429-8bdb88b9f907?auto=format&amp;w=1200&amp;q=80&amp;fit=crop\">\n<div class=\"absolute inset-0 bg-linear-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500\" data-kid=\"8-1-1-1-1-2\"></div>\n</div>\n\n<div class=\"absolute -bottom-10 -right-10 w-72 h-56 glass p-2 rounded-[32px] border-black border-[12px] shadow-2xl z-20 overflow-hidden hidden md:block\" data-kid=\"8-1-1-1-2\" data-scroll=\"\" data-scroll-speed=\"0.5\" id=\"success-gallery-peek\">\n<img alt=\"Software Dashboard\" class=\"w-full h-full object-cover rounded-[20px]\" data-kid=\"8-1-1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1554643895-20d00c6cdeda?auto=format&amp;w=600&amp;q=80&amp;fit=crop\">\n</div>\n</div>\n\n<div class=\"reveal-right\" data-kid=\"8-1-1-2\">\n<span class=\"text-[var(--color-coral)] font-bold tracking-widest uppercase text-xs\" data-kid=\"8-1-1-2-1\">Featured Success</span>\n<h2 class=\"font-heading text-4xl md:text-6xl mt-6 mb-10 font-extrabold leading-[1.1]\" data-kid=\"8-1-1-2-2\">Bakery Management Transformed.</h2>\n<p class=\"text-xl text-white/50 mb-10 leading-relaxed\" data-kid=\"8-1-1-2-3\">\n          The Artisan Hearth went from manually tracking flour inventory on clipboards to a fully automated multi-site POS system.\n        </p>\n<div class=\"grid sm:grid-cols-2 gap-8 mb-12\" data-kid=\"8-1-1-2-4\">\n<div class=\"p-6 glass rounded-[32px] border-white/5\" data-kid=\"8-1-1-2-4-1\">\n<div class=\"text-[var(--color-blue)] text-3xl font-bold mb-2\" data-kid=\"8-1-1-2-4-1-1\">30%</div>\n<div class=\"text-white/40 text-sm font-bold uppercase tracking-widest\" data-kid=\"8-1-1-2-4-1-2\">Waste Reduction</div>\n</div>\n<div class=\"p-6 glass rounded-[32px] border-white/5\" data-kid=\"8-1-1-2-4-2\">\n<div class=\"text-[var(--color-coral)] text-3xl font-bold mb-2\" data-kid=\"8-1-1-2-4-2-1\">12ms</div>\n<div class=\"text-white/40 text-sm font-bold uppercase tracking-widest\" data-kid=\"8-1-1-2-4-2-2\">Sync Latency</div>\n</div>\n</div>\n<button class=\"group px-10 py-5 bg-white text-black rounded-2xl font-black uppercase tracking-widest text-xs hover:bg-[var(--color-blue)] hover:text-white transition-all flex items-center justify-center gap-3\" data-kid=\"8-1-1-2-5\">\n          Read Full Case Study\n          <i class=\"fas fa-arrow-right text-xs group-hover:translate-x-2 transition-transform\" data-kid=\"8-1-1-2-5-1\"></i>\n</button>\n</div>\n</div>\n</div>\n</section>\n\n<section class=\"min-h-screen flex flex-col items-center justify-center relative overflow-hidden px-6 bg-[#0A0F16]\" data-kid=\"9\" data-name=\"cta section\">\n<div class=\"ticker-container absolute top-1/2 -translate-y-1/2 opacity-[0.03] pointer-events-none select-none\" data-kid=\"9-1\" data-name=\"ticker background container\">\n<div class=\"ticker-track\" data-kid=\"9-1-1\" data-name=\"ticker track\">\n<span class=\"text-[20vw] font-heading font-black px-10\" data-kid=\"9-1-1-1\" data-name=\"ticker text 1\">SKIP THE FORMS • </span>\n<span class=\"text-[20vw] font-heading font-black px-10\" data-kid=\"9-1-1-2\" data-name=\"ticker text 2\">TALK TO A HUMAN • </span>\n</div>\n</div>\n<div class=\"relative z-10 text-center max-w-4xl\" data-kid=\"9-2\" data-name=\"cta content\">\n<div class=\"magnetic-area mb-16\" data-kid=\"9-2-1\" data-name=\"whatsapp main button wrapper\">\n<a class=\"inline-flex w-40 h-40 md:w-56 md:h-56 bg-[var(--color-blue)] rounded-full items-center justify-center text-white shadow-[0_0_80px_rgba(0,191,255,0.4)] hover:scale-110 active:scale-95 group\" data-cursor=\"magnetic\" data-kid=\"9-2-1-1\" data-name=\"whatsapp main button\" href=\"https://wa.me/yournumber\" id=\"whatsapp-main-btn\" target=\"_blank\">\n<i class=\"fab fa-whatsapp text-6xl md:text-8xl transition-transform\" data-kid=\"9-2-1-1-1\" data-name=\"whatsapp icon\"></i>\n</a>\n</div>\n<h2 class=\"font-heading text-5xl md:text-8xl font-black mb-8 tracking-tighter\" data-kid=\"9-2-2\" data-name=\"cta title\">Ready to<br data-kid=\"9-2-2-1\" data-name=\"cta title line break\">streamline?</h2>\n<p class=\"text-xl md:text-2xl text-white/40 font-bold uppercase tracking-[0.2em]\" data-kid=\"9-2-3\" data-name=\"cta subheadline\">No sales cycles. Just software.</p>\n</div>\n</section>\n\n<footer class=\"py-20 px-6 bg-[#080B11] border-t border-white/5\" data-kid=\"10\">\n<div class=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-12\" data-kid=\"10-1\">\n<div class=\"flex flex-col items-center md:items-start gap-6\" data-kid=\"10-1-1\">\n<img alt=\"Solum SF Logo\" class=\"h-8 opacity-60 grayscale hover:grayscale-0 transition-all\" data-kid=\"10-1-1-1\" src=\"/api/local/images/data://attachments/images/image-1-2026-07-14_02-08-03.png\">\n<p class=\"text-white/20 text-sm\" data-kid=\"10-1-1-2\">© 2024 Solum Software Factory. All rights reserved.</p>\n</div>\n<div class=\"flex gap-12 text-sm font-bold uppercase tracking-widest text-white/30\" data-kid=\"10-1-2\">\n<a class=\"hover:text-white transition-colors\" data-kid=\"10-1-2-1\" href=\"#\">Privacy</a>\n<a class=\"hover:text-white transition-colors\" data-kid=\"10-1-2-2\" href=\"#\">Terms</a>\n<a class=\"hover:text-white transition-colors\" data-kid=\"10-1-2-3\" href=\"#\">Security</a>\n</div>\n<div class=\"flex gap-6\" data-kid=\"10-1-3\">\n<a class=\"w-10 h-10 glass flex items-center justify-center rounded-full hover:bg-white/10 transition-colors\" data-kid=\"10-1-3-1\" href=\"#\"><i class=\"fab fa-linkedin-in\" data-kid=\"10-1-3-1-1\"></i></a>\n<a class=\"w-10 h-10 glass flex items-center justify-center rounded-full hover:bg-white/10 transition-colors\" data-kid=\"10-1-3-2\" href=\"#\"><i class=\"fab fa-twitter\" data-kid=\"10-1-3-2-1\"></i></a>\n<a class=\"w-10 h-10 glass flex items-center justify-center rounded-full hover:bg-white/10 transition-colors\" data-kid=\"10-1-3-3\" href=\"#\"><i class=\"fab fa-github\" data-kid=\"10-1-3-3-1\"></i></a>\n</div>\n</div>\n</footer>\n\n<link data-kid=\"11\" href=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.css\" rel=\"stylesheet\">\n<script src=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.min.js\" data-kid=\"17\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\" data-kid=\"18\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\" data-kid=\"19\"></script>\n<script type=\"module\" data-kid=\"20\">\n  import { animate, scroll, inView } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\";\n  import { animate as animeAnimate, utils } from 'https://esm.sh/animejs@4';\n  \n  // Locomotive Scroll v5\n  const locomotiveScroll = new LocomotiveScroll();\n\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Custom Cursor\n  const cursor = document.querySelector('.custom-cursor');\n  window.addEventListener('mousemove', (e) => {\n    gsap.to(cursor, {\n      x: e.clientX,\n      y: e.clientY,\n      duration: 0.2,\n      ease: \"power2.out\"\n    });\n  });\n\n  // Nav Links Interaction\n  const navLinks = document.querySelectorAll('.nav-item');\n  const navIndicator = document.getElementById('nav-indicator');\n\n  navLinks.forEach(link => {\n    link.addEventListener('mouseenter', (e) => {\n      const rect = e.target.getBoundingClientRect();\n      const parentRect = e.target.parentElement.getBoundingClientRect();\n      gsap.to(navIndicator, {\n        left: rect.left - parentRect.left,\n        width: rect.width,\n        opacity: 1,\n        duration: 0.4,\n        ease: \"power3.out\"\n      });\n    });\n  });\n\n  document.getElementById('nav-links').addEventListener('mouseleave', () => {\n    gsap.to(navIndicator, { opacity: 0, duration: 0.3 });\n  });\n\n  // Magnetic Buttons\n  const magnets = document.querySelectorAll('.magnetic-area');\n  magnets.forEach(m => {\n    const btn = m.querySelector('button, a');\n    m.addEventListener('mousemove', (e) => {\n      const rect = m.getBoundingClientRect();\n      const x = (e.clientX - rect.left - rect.width / 2) * 0.4;\n      const y = (e.clientY - rect.top - rect.height / 2) * 0.4;\n      gsap.to(btn, { x, y, duration: 0.6, ease: \"power2.out\" });\n    });\n    m.addEventListener('mouseleave', () => {\n      gsap.to(btn, { x: 0, y: 0, duration: 0.8, ease: \"elastic.out(1, 0.3)\" });\n    });\n  });\n\n  // Hero Reveal\n  const heroTl = gsap.timeline();\n  heroTl.from(\".reveal-up\", {\n    y: 100,\n    opacity: 0,\n    duration: 1.2,\n    stagger: 0.2,\n    ease: \"expo.out\"\n  });\n\n  // Morphing Blobs\n  gsap.to(\"#blob-1\", {\n    x: \"20vw\",\n    y: \"-10vh\",\n    duration: 20,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n  gsap.to(\"#blob-2\", {\n    x: \"-10vw\",\n    y: \"10vh\",\n    duration: 25,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  // SVG Scroll Drawing\n  const path = document.querySelector(\"#stream-path\");\n  const pathLength = path.getTotalLength();\n  gsap.set(path, { strokeDasharray: pathLength, strokeDashoffset: pathLength });\n  \n  scroll(\n    animate(path, { strokeDashoffset: [pathLength, 0] }, { ease: \"linear\" }),\n    { \n      target: document.querySelector(\"#work\"),\n      offset: [\"start end\", \"end start\"]\n    }\n  );\n\n  // Scroll Animations (GSAP)\n  gsap.utils.toArray(\".reveal-left\").forEach(el => {\n    gsap.from(el, {\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 85%\",\n      },\n      x: -100,\n      opacity: 0,\n      duration: 1,\n      ease: \"power3.out\"\n    });\n  });\n\n  gsap.utils.toArray(\".reveal-right\").forEach(el => {\n    gsap.from(el, {\n      scrollTrigger: {\n        trigger: el,\n        start: \"top 85%\",\n      },\n      x: 100,\n      opacity: 0,\n      duration: 1,\n      ease: \"power3.out\"\n    });\n  });\n\n  // Success Image Parallax (removed scale from img directly if Locomotive is doing work, but Motion is fine here)\n  scroll(\n    animate(\"#success-gallery-main img\", { scale: [1, 1.1] }, { ease: \"linear\" }),\n    {\n      target: document.querySelector(\"#success\"),\n      offset: [\"start end\", \"end start\"]\n    }\n  );\n\n  // Tech Constellation\n  const constellationSvg = document.getElementById('constellation-svg');\n  const nodes = document.querySelectorAll('.tech-node');\n  \n  function updateLines() {\n    constellationSvg.innerHTML = '';\n    const parent = constellationSvg.getBoundingClientRect();\n    const centerNode = nodes[1].getBoundingClientRect();\n    \n    nodes.forEach((node, i) => {\n      if(i === 1) return;\n      const rect = node.getBoundingClientRect();\n      const line = document.createElementNS(\"http://www.w3.org/2000/svg\", \"line\");\n      line.setAttribute(\"x1\", centerNode.left - parent.left + centerNode.width/2);\n      line.setAttribute(\"y1\", centerNode.top - parent.top + centerNode.height/2);\n      line.setAttribute(\"x2\", rect.left - parent.left + rect.width/2);\n      line.setAttribute(\"y2\", rect.top - parent.top + rect.height/2);\n      line.setAttribute(\"stroke\", \"rgba(255,255,255,0.15)\");\n      line.setAttribute(\"stroke-width\", \"1\");\n      constellationSvg.appendChild(line);\n    });\n  }\n\n  window.addEventListener('load', () => {\n    setTimeout(updateLines, 200);\n  });\n  window.addEventListener('resize', updateLines);\n\n  // Ambient Drift for Nodes\n  nodes.forEach((node, i) => {\n    animeAnimate(node, {\n      translateX: [() => utils.random(-20, 20), () => utils.random(-20, 20)],\n      translateY: [() => utils.random(-20, 20), () => utils.random(-20, 20)],\n      duration: 8000 + i * 1000,\n      alternate: true,\n      loop: true,\n      ease: \"inOut(3)\",\n      onLoop: self => {\n        self.refresh();\n      },\n      update: updateLines\n    });\n  });\n\n  // Cursor Hover Scale\n  const interactive = document.querySelectorAll('button, a, .tech-node');\n  interactive.forEach(el => {\n    el.addEventListener('mouseenter', () => {\n      gsap.to(cursor, { scale: 3, opacity: 0.3, duration: 0.3 });\n    });\n    el.addEventListener('mouseleave', () => {\n      gsap.to(cursor, { scale: 1, opacity: 1, duration: 0.3 });\n    });\n  });\n\n</script>\n",
      "comments": [],
      "created": "2026-07-14T02:10:06.864472+00:00",
      "modified": "2026-07-14T02:10:06.864472+00:00",
