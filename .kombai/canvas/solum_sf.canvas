      "viewportScrollY": 0
    },
    "var_17d66e09beac": {
      "type": "variant",
      "label": "Variant 3: Industrial Terminal",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2710.0850813906,
        "y": -1405.7281420563986,
        "w": 1440,
        "h": 800
      },
      "html": "\n<style data-kid=\"0\">\n    @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500;700&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n    @import url('https://unpkg.com/lenis@1/dist/lenis.css');\n\n    :root {\n        --onyx: #111111;\n        --carbon: #1B1B1B;\n        --flame: #FF4F00;\n        --platinum: #F2F3F4;\n    }\n\n    .solum-container {\n        background-color: var(--onyx);\n        color: var(--platinum);\n        font-family: 'JetBrains Mono', monospace;\n        min-height: 100vh;\n        overflow-x: clip;\n    }\n\n    .font-heading { font-family: 'Space Grotesk', sans-serif; }\n\n    .text-stroke {\n        -webkit-text-stroke: 1px rgba(242, 243, 244, 0.3);\n        color: transparent;\n    }\n\n    .grid-paper-bg {\n        background-image: \n            linear-gradient(rgba(242, 243, 244, 0.05) 1px, transparent 1px),\n            linear-gradient(90deg, rgba(242, 243, 244, 0.05) 1px, transparent 1px);\n        background-size: 40px 40px;\n    }\n\n    .halftone-overlay {\n        background-image: radial-gradient(circle, var(--platinum) 1px, transparent 1px);\n        background-size: 8px 8px;\n        opacity: 0.1;\n        pointer-events: none;\n    }\n\n    .brutalist-border {\n        border: 3px solid var(--flame);\n        box-shadow: 6px 6px 0px 0px rgba(255, 79, 0, 0.2);\n    }\n\n    .blueprint-line {\n        background: linear-gradient(90deg, transparent, var(--flame), transparent);\n        height: 1px;\n        width: 100%;\n        opacity: 0.2;\n    }\n\n    /* Terminal Noise Style */\n    .terminal-noise {\n        font-size: 8px;\n        color: rgba(242, 243, 244, 0.1);\n        pointer-events: none;\n    }\n\n    .blueprint-node {\n        border: 1px dashed rgba(255, 79, 0, 0.3);\n        padding: 1rem;\n        position: relative;\n    }\n\n    .blueprint-node::after {\n        content: '';\n        position: absolute;\n        top: -4px; left: -4px; width: 8px; height: 8px;\n        background: var(--flame);\n    }\n\n    .blueprint-crosshair {\n        position: absolute;\n        width: 20px;\n        height: 20px;\n        border: 1px solid var(--flame);\n        opacity: 0.3;\n    }\n\n    .nav-glow:hover {\n        filter: drop-shadow(0 0 8px var(--flame));\n        color: var(--flame);\n    }\n</style>\n<div class=\"solum-container selection:bg-[var(--flame)] selection:text-white\" data-kid=\"1\">\n\n<nav class=\"fixed left-0 top-0 h-screen w-[80px] bg-[var(--onyx)] border-r border-[var(--platinum)]/10 flex flex-col items-center py-8 z-50\" data-kid=\"1-1\" data-name=\"navigation sidebar\" id=\"icon-rail\">\n<div class=\"mb-12\" data-kid=\"1-1-1\" data-name=\"navigation logo container\">\n<svg data-kid=\"1-1-1-1\" fill=\"none\" height=\"40\" viewbox=\"0 0 40 40\" width=\"40\" xmlns=\"http://www.w3.org/2000/svg\">\n<path d=\"M20 5L32 12V28L20 35L8 28V12L20 5Z\" stroke=\"#FF4F00\" stroke-width=\"2\" data-kid=\"2\"></path>\n<path d=\"M20 5L32 12L20 19L8 12L20 5Z\" fill=\"#FF4F00\" fill-opacity=\"0.3\" stroke=\"#FF4F00\" data-kid=\"3\"></path>\n<path d=\"M20 19V35\" stroke=\"#FF4F00\" stroke-width=\"1\" data-kid=\"4\"></path>\n<text fill=\"#FF4F00\" font-family=\"Space Grotesk\" font-size=\"12\" font-weight=\"900\" x=\"14\" y=\"27\" data-kid=\"5\">SF</text>\n</svg>\n</div>\n<div class=\"flex flex-col gap-8 flex-1\" data-kid=\"1-1-2\" data-name=\"navigation link group\">\n<a class=\"text-[var(--platinum)]/40 nav-glow transition-all text-2xl\" data-kid=\"1-1-2-1\" data-name=\"terminal icon link\" href=\"#\" title=\"Console\"><i class=\"ti ti-terminal-2\" data-kid=\"1-1-2-1-1\"></i></a>\n<a class=\"text-[var(--platinum)]/40 nav-glow transition-all text-2xl\" data-kid=\"1-1-2-2\" data-name=\"schema icon link\" href=\"#\" title=\"Schema\"><i class=\"ti ti-schema\" data-kid=\"1-1-2-2-1\"></i></a>\n<a class=\"text-[var(--platinum)]/40 nav-glow transition-all text-2xl\" data-kid=\"1-1-2-3\" data-name=\"box model icon link\" href=\"#\" title=\"Architecture\"><i class=\"ti ti-box-model-2\" data-kid=\"1-1-2-3-1\"></i></a>\n<a class=\"text-[var(--platinum)]/40 nav-glow transition-all text-2xl\" data-kid=\"1-1-2-4\" data-name=\"bug icon link\" href=\"#\" title=\"Debug\"><i class=\"ti ti-bug\" data-kid=\"1-1-2-4-1\"></i></a>\n</div>\n<div class=\"mt-auto\" data-kid=\"1-1-3\" data-name=\"whatsapp contact button container\">\n<a class=\"w-12 h-12 rounded-full bg-[var(--flame)] flex items-center justify-center text-white text-2xl hover:scale-110 transition-transform shadow-[0_0_20px_rgba(255,79,0,0.4)]\" data-kid=\"1-1-3-1\" data-name=\"whatsapp contact button\" href=\"https://wa.me/yournumber\" target=\"_blank\">\n<i class=\"ti ti-brand-whatsapp\" data-kid=\"1-1-3-1-1\"></i>\n</a>\n</div>\n</nav>\n<main class=\"ml-[80px]\" data-kid=\"1-2\" data-name=\"main content container\">\n\n<section class=\"min-h-screen flex flex-col justify-center px-12 md:px-24 py-20 relative overflow-hidden\" data-kid=\"1-2-1\" data-name=\"hero section\" id=\"hero\">\n<div class=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] opacity-[0.02] pointer-events-none select-none overflow-hidden\" data-kid=\"1-2-1-1\" data-name=\"hero background watermark container\">\n<div class=\"text-[40rem] font-black text-[var(--platinum)] leading-none rotate-12\" data-kid=\"1-2-1-1-1\" data-name=\"hero background watermark text\">FACTORY</div>\n</div>\n<div class=\"w-full max-w-5xl brutalist-border bg-[var(--carbon)] overflow-hidden mb-16 relative z-10\" data-kid=\"1-2-1-2\" data-name=\"terminal command line interface container\" id=\"terminal-cli\">\n<div class=\"bg-[var(--onyx)] border-b border-[var(--flame)]/50 px-4 py-2 flex items-center justify-between\" data-kid=\"1-2-1-2-1\" data-name=\"terminal top bar\">\n<div class=\"flex gap-2\" data-kid=\"1-2-1-2-1-1\" data-name=\"terminal status dots container\">\n<div class=\"w-3 h-3 rounded-full bg-[var(--flame)]\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"terminal dot red\"></div>\n<div class=\"w-3 h-3 rounded-full bg-[var(--flame)]/40\" data-kid=\"1-2-1-2-1-1-2\" data-name=\"terminal dot yellow\"></div>\n<div class=\"w-3 h-3 rounded-full bg-[var(--flame)]/20\" data-kid=\"1-2-1-2-1-1-3\" data-name=\"terminal dot green\"></div>\n</div>\n<div class=\"text-[var(--platinum)]/40 text-[10px] uppercase tracking-widest font-mono\" data-kid=\"1-2-1-2-1-2\" data-name=\"terminal version title text\">solum_terminal_v4.0.0-industrial</div>\n<div class=\"flex gap-4\" data-kid=\"1-2-1-2-1-3\" data-name=\"terminal CPU/RAM info container\">\n<span class=\"text-[var(--platinum)]/20 text-[8px] font-mono\" data-kid=\"1-2-1-2-1-3-1\" data-name=\"CPU load text\">CPU: 42%</span>\n<span class=\"text-[var(--platinum)]/20 text-[8px] font-mono\" data-kid=\"1-2-1-2-1-3-2\" data-name=\"RAM usage text\">RAM: 1.2GB</span>\n</div>\n</div>\n<div class=\"p-10 font-mono\" data-kid=\"1-2-1-2-2\" data-name=\"terminal output content area\">\n<div class=\"flex items-center gap-3 mb-6\" data-kid=\"1-2-1-2-2-1\" data-name=\"typewriter line container\">\n<span class=\"text-[var(--flame)] font-bold text-2xl animate-pulse\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"terminal prompt symbol\">SOLUM &gt;</span>\n<span class=\"text-3xl md:text-5xl font-bold tracking-tighter text-[var(--platinum)]\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-1-2\" data-name=\"typewriter text element\" data-reason=\"text content typed dynamically by script on load\" id=\"hero-typewriter\"></span>\n<span class=\"w-3 h-10 md:h-14 bg-[var(--flame)] animate-pulse\" data-kid=\"1-2-1-2-2-1-3\" data-name=\"cursor blinker\"></span>\n</div>\n<div class=\"opacity-0 hero-content-reveal\" data-kid=\"1-2-1-2-2-2\" data-name=\"hero content reveal container\">\n<p class=\"text-[var(--platinum)]/80 text-lg md:text-xl max-w-2xl mb-12 leading-relaxed border-l-2 border-[var(--flame)] pl-6\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"hero description text\">\n                            Deploying resilient, high-throughput architectures for industrial SME operations. We replace chaos with deterministic software pipelines.\n                        </p>\n<div class=\"flex flex-wrap items-center gap-8\" data-kid=\"1-2-1-2-2-2-2\" data-name=\"cta group\">\n<button class=\"bg-[var(--flame)] text-white px-10 py-5 font-black uppercase tracking-[0.2em] hover:bg-[var(--platinum)] hover:text-[var(--onyx)] transition-all duration-300 flex items-center gap-4 group\" data-kid=\"1-2-1-2-2-2-2-1\" data-name=\"initiate protocol call-to-action button\">\n<span class=\"text-xs opacity-50 font-mono\" data-kid=\"1-2-1-2-2-2-2-1-1\" data-name=\"shell script label\">sh</span>\n                                ./initiate_contact\n                                <i class=\"ti ti-chevron-right group-hover:translate-x-1 transition-transform\" data-kid=\"1-2-1-2-2-2-2-1-2\" data-name=\"right chevron icon\"></i>\n</button>\n<div class=\"flex flex-col\" data-kid=\"1-2-1-2-2-2-2-2\" data-name=\"status log container\">\n<span class=\"text-[var(--flame)] text-[10px] font-bold uppercase tracking-widest mb-1\" data-kid=\"1-2-1-2-2-2-2-2-1\" data-name=\"status log label\">// STATUS_LOG</span>\n<div class=\"flex items-center gap-2 text-[var(--platinum)]/40 text-xs font-mono\" data-kid=\"1-2-1-2-2-2-2-2-2\" data-name=\"status indicator\">\n<div class=\"w-2 h-2 rounded-full bg-green-500 animate-ping\" data-kid=\"1-2-1-2-2-2-2-2-2-1\" data-name=\"status ping indicator\"></div>\n                                    CORE_LOAD_READY\n                                </div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"hero-subtext opacity-0 hero-content-reveal relative z-10 flex flex-col md:flex-row items-baseline gap-8\" data-kid=\"1-2-1-3\" data-name=\"hero subtext section\">\n<h1 class=\"text-7xl md:text-[11rem] font-black leading-[0.75] uppercase tracking-tighter font-heading\" data-kid=\"1-2-1-3-1\" data-name=\"hero headline text\">\n                    SYSTEMS<br data-kid=\"1-2-1-3-1-1\" data-name=\"hero headline text part 1\"><span class=\"text-[var(--flame)]\" data-kid=\"1-2-1-3-1-2\" data-name=\"hero headline text part 2\">REWIRED.</span>\n</h1>\n<div class=\"text-[var(--platinum)]/30 text-xs font-mono max-w-[200px] leading-loose uppercase tracking-[0.1em]\" data-kid=\"1-2-1-3-2\" data-name=\"hero geolocation and info text\">\n                    [41.8781° N, 87.6298° W]<br data-kid=\"1-2-1-3-2-1\" data-name=\"info text line break\">\n                    BUILDING THE NEXT GENERATION OF INDUSTRIAL INTERFACES.\n                </div>\n</div>\n</section>\n\n<section class=\"min-h-screen grid grid-cols-1 md:grid-cols-2 grid-rows-2 border-t border-[var(--platinum)]/10 bg-[var(--onyx)] relative\" data-kid=\"1-2-2\" data-name=\"problem quadrants section\" id=\"quadrants\">\n<div class=\"border-r border-b border-[var(--platinum)]/10 p-12 md:p-24 flex flex-col justify-end group cursor-crosshair hover:bg-[var(--carbon)] transition-colors duration-500 relative overflow-hidden\" data-kid=\"1-2-2-1\" data-name=\"data silos quadrant\">\n<div class=\"terminal-noise absolute top-4 left-4 font-mono leading-none bg-[var(--onyx)]/80 p-1\" data-kid=\"1-2-2-1-1\" data-name=\"data silos log info\">\n                    LOG_0X01: DATA_INTEGRITY_ERR<br data-kid=\"1-2-2-1-1-1\" data-name=\"data silos log line 1\">TIMESTAMP: 1723910239<br data-kid=\"1-2-2-1-1-2\" data-name=\"data silos log line 2\">HEX: FF 43 12 A1 09\n                </div>\n<div class=\"text-[var(--flame)] text-xs mb-4 tracking-[0.3em] font-bold font-mono\" data-kid=\"1-2-2-1-2\" data-name=\"data silos segment label\">SEGMENT_01</div>\n<h3 class=\"text-5xl md:text-7xl text-[var(--platinum)] font-black uppercase tracking-tighter mb-6 scramble-trigger font-heading\" data-dynamic=\"true\" data-kid=\"1-2-2-1-3\" data-name=\"data silos title\" data-reason=\"text scrambled/reinitialized on hover by script\" data-scramble=\"DATA SILOS\">DATA SILOS</h3>\n<p class=\"text-[var(--platinum)]/50 max-w-sm font-mono text-base leading-relaxed\" data-kid=\"1-2-2-1-4\" data-name=\"data silos description text\">\n                    Intelligence trapped in isolated sheets. We rebuild the neural pathways of your business.\n                </p>\n<div class=\"mt-8 h-1 w-0 group-hover:w-full bg-[var(--flame)] transition-all duration-700\" data-kid=\"1-2-2-1-5\" data-name=\"hover underline indicator\"></div>\n</div>\n<div class=\"border-b border-[var(--platinum)]/10 p-12 md:p-24 flex flex-col justify-end group cursor-crosshair hover:bg-[var(--carbon)] transition-colors duration-500 relative overflow-hidden\" data-kid=\"1-2-2-2\" data-name=\"offline failure quadrant\">\n<div class=\"terminal-noise absolute top-4 left-4 font-mono leading-none\" data-kid=\"1-2-2-2-1\" data-name=\"offline failure log info\">\n                    LOG_0X02: NET_RECOVERY_FAIL<br data-kid=\"1-2-2-2-1-1\" data-name=\"offline failure log line 1\">MTBF: 12.4H<br data-kid=\"1-2-2-2-1-2\" data-name=\"offline failure log line 2\">STATE: UNSTABLE\n                </div>\n<div class=\"text-[var(--flame)] text-xs mb-4 tracking-[0.3em] font-bold font-mono\" data-kid=\"1-2-2-2-2\" data-name=\"offline failure segment label\">SEGMENT_02</div>\n<h3 class=\"text-5xl md:text-7xl text-[var(--platinum)] font-black uppercase tracking-tighter mb-6 scramble-trigger font-heading\" data-dynamic=\"true\" data-kid=\"1-2-2-2-3\" data-name=\"offline failure title\" data-reason=\"text scrambled/reinitialized on hover by script\" data-scramble=\"OFFLINE FAILURE\">OFFLINE FAILURE</h3>\n<p class=\"text-[var(--platinum)]/50 max-w-sm font-mono text-base leading-relaxed\" data-kid=\"1-2-2-2-4\" data-name=\"offline failure description text\">\n                    Downtime is a casualty of poor architecture. Our offline-first engine guarantees continuity.\n                </p>\n<div class=\"mt-8 h-1 w-0 group-hover:w-full bg-[var(--flame)] transition-all duration-700\" data-kid=\"1-2-2-2-5\" data-name=\"hover underline indicator\"></div>\n</div>\n<div class=\"border-r border-[var(--platinum)]/10 p-12 md:p-24 flex flex-col justify-end group cursor-crosshair hover:bg-[var(--carbon)] transition-colors duration-500 relative overflow-hidden\" data-kid=\"1-2-2-3\" data-name=\"frictional UI quadrant\">\n<div class=\"terminal-noise absolute top-4 left-4 font-mono leading-none\" data-kid=\"1-2-2-3-1\" data-name=\"frictional UI log info\">\n                    LOG_0X03: UX_FRICTION_ALARM<br data-kid=\"1-2-2-3-1-1\" data-name=\"frictional UI log line 1\">MAN_HOURS_LOST: 1400/MO<br data-kid=\"1-2-2-3-1-2\" data-name=\"frictional UI log line 2\">KPI: RED\n                </div>\n<div class=\"text-[var(--flame)] text-xs mb-4 tracking-[0.3em] font-bold font-mono\" data-kid=\"1-2-2-3-2\" data-name=\"frictional UI segment label\">SEGMENT_03</div>\n<h3 class=\"text-5xl md:text-7xl text-[var(--platinum)] font-black uppercase tracking-tighter mb-6 scramble-trigger font-heading\" data-dynamic=\"true\" data-kid=\"1-2-2-3-3\" data-name=\"frictional UI title\" data-reason=\"text scrambled/reinitialized on hover by script\" data-scramble=\"FRICTIONAL UI\">FRICTIONAL UI</h3>\n<p class=\"text-[var(--platinum)]/50 max-w-sm font-mono text-base leading-relaxed\" data-kid=\"1-2-2-3-4\" data-name=\"frictional UI description text\">\n                    Software shouldn't be a hurdle. We craft interfaces that respond as fast as thought.\n                </p>\n<div class=\"mt-8 h-1 w-0 group-hover:w-full bg-[var(--flame)] transition-all duration-700\" data-kid=\"1-2-2-3-5\" data-name=\"hover underline indicator\"></div>\n</div>\n<div class=\"p-12 md:p-24 flex flex-col justify-end group cursor-crosshair hover:bg-[var(--carbon)] transition-colors duration-500 relative overflow-hidden\" data-kid=\"1-2-2-4\" data-name=\"blind scaling quadrant\">\n<div class=\"terminal-noise absolute top-4 left-4 font-mono leading-none\" data-kid=\"1-2-2-4-1\" data-name=\"blind scaling 