      "html": "<div class=\"bg-[#010B13] text-white font-['Inter'] selection:bg-[#00CCFF]/30 selection:text-white\" data-kid=\"1\" style=\"overflow-x: clip;\">\n<link data-kid=\"1-1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\">\n<link data-kid=\"1-2\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\" rel=\"stylesheet\">\n<style data-kid=\"0\">\n        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;900&family=Inter:wght@300;400;500;600&display=swap');\n\n        :root {\n            --bg-deep: #010B13;\n            --surface-dark: #11151D;\n            --accent-orange: #FF5800;\n            --accent-cyan: #00CCFF;\n        }\n\n        .font-heading { font-family: 'Space Grotesk', sans-serif; }\n\n        .neon-orange { color: var(--accent-orange); text-shadow: 0 0 15px rgba(255, 88, 0, 0.6); }\n        .neon-cyan { color: var(--accent-cyan); text-shadow: 0 0 15px rgba(0, 204, 255, 0.6); }\n        \n        .neon-inset {\n            border: 1px solid rgba(0, 204, 255, 0.15);\n            background: linear-gradient(135deg, #0a0a1a 0%, #05050f 100%);\n            clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 20px 100%, 0 calc(100% - 20px));\n            box-shadow: 0 0 15px rgba(0, 204, 255, 0.02);\n            position: relative;\n        }\n        .neon-inset::before {\n            content: '';\n            position: absolute;\n            top: 0; left: 0; right: 0; bottom: 0;\n            background: radial-gradient(circle at top left, rgba(0, 204, 255, 0.05), transparent 40%);\n            pointer-events: none;\n        }\n        .neon-inset:hover {\n            border-color: rgba(0, 204, 255, 0.4);\n            box-shadow: 0 0 25px rgba(0, 204, 255, 0.1);\n        }\n\n        .spotlight-hero {\n            background: radial-gradient(circle at 75% 15%, rgba(0, 204, 255, 0.15) 0%, transparent 50%),\n                        radial-gradient(circle at 25% 85%, rgba(255, 88, 0, 0.05) 0%, transparent 40%);\n        }\n\n        .text-stroke {\n            -webkit-text-stroke: 1px rgba(255, 255, 255, 0.1);\n            color: transparent;\n        }\n        .text-stroke-heavy {\n            -webkit-text-stroke: 2px rgba(255, 255, 255, 0.05);\n            color: transparent;\n        }\n        .noise-overlay {\n            position: fixed;\n            top: 0; left: 0; width: 100%; height: 100%;\n            background: url(\"https://grainy-gradients.vercel.app/noise.svg\");\n            opacity: 0.03;\n            pointer-events: none;\n            z-index: 100;\n        }\n\n        .marquee-container {\n            display: flex;\n            white-space: nowrap;\n            overflow: hidden;\n            user-select: none;\n        }\n\n        .marquee-content {\n            display: flex;\n            gap: 4rem;\n            flex-shrink: 0;\n            min-width: 100%;\n        }\n\n        .circuitry-pattern {\n            background-image: url(\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/circuitry.svg\");\n            background-size: 240px;\n            background-repeat: repeat;\n            opacity: 0.04;\n        }\n\n        #pill-nav {\n            transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease, backdrop-filter 0.3s ease;\n        }\n\n        #pill-nav.hidden-nav {\n            transform: translate(-50%, -100px);\n            opacity: 0;\n        }\n\n        .ladder-line {\n            background: repeating-linear-gradient(to bottom, transparent, transparent 12px, rgba(255, 255, 255, 0.08) 12px, rgba(255, 255, 255, 0.08) 24px);\n        }\n\n        .glass-card {\n            background: rgba(17, 21, 29, 0.6);\n            backdrop-filter: blur(12px);\n            border: 1px solid rgba(255, 255, 255, 0.05);\n        }\n\n        /* Custom Scrollbar */\n        ::-webkit-scrollbar { width: 6px; }\n        ::-webkit-scrollbar-track { background: var(--bg-deep); }\n        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.1); border-radius: 10px; }\n        ::-webkit-scrollbar-thumb:hover { background: var(--accent-cyan); }\n    </style>\n<div class=\"noise-overlay\" data-kid=\"1-3\" data-name=\"page noise texture overlay\"></div>\n\n<nav class=\"fixed top-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 p-2 glass-card shadow-[0_20px_50px_rgba(0,0,0,0.5)] border-white/10\" data-kid=\"1-4\" data-name=\"main floating navigation bar\" id=\"pill-nav\" style=\"clip-path: polygon(0 0, 98% 0, 100% 20%, 100% 100%, 2% 100%, 0 80%);\">\n<div class=\"px-5 py-2 flex items-center gap-3 border-r border-white/10 mr-2 shrink-0\" data-kid=\"1-4-1\" data-name=\"navigation branding container\">\n<svg class=\"h-8 w-8 drop-shadow-[0_0_8px_rgba(255,88,0,0.6)]\" data-kid=\"1-4-1-1\" data-name=\"geometric company logo\" viewbox=\"0 0 100 100\">\n<path d=\"M20,35 L50,20 L80,35 L80,65 L50,80 L20,65 Z\" fill=\"none\" stroke=\"#FF5800\" stroke-width=\"8\" data-kid=\"2\"></path>\n<path d=\"M50,20 L50,80 M20,35 L80,65 M80,35 L20,65\" opacity=\"0.5\" stroke=\"#FF5800\" stroke-width=\"4\" data-kid=\"3\"></path>\n</svg>\n</div>\n<div class=\"hidden lg:flex items-center gap-1\" data-kid=\"1-4-2\" data-name=\"navigation link container\">\n<a class=\"px-5 py-2 text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400 hover:text-[#00CCFF] transition-colors\" data-kid=\"1-4-2-1\" data-name=\"problems link\" href=\"#split-comparison\">Problemas</a>\n<a class=\"px-5 py-2 text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400 hover:text-[#00CCFF] transition-colors\" data-kid=\"1-4-2-2\" data-name=\"solutions link\" href=\"#dashboard-bento\">Solución</a>\n<a class=\"px-5 py-2 text-[10px] font-bold uppercase tracking-[0.3em] text-gray-400 hover:text-[#00CCFF] transition-colors\" data-kid=\"1-4-2-3\" data-name=\"technology link\" href=\"#dual-marquee\">Tecnología</a>\n</div>\n<a class=\"ml-2 px-6 py-3 text-[10px] font-black uppercase tracking-[0.2em] bg-[#FF5800] text-white hover:brightness-110 flex items-center gap-2 clip-path-[polygon(0_0,90%_0,100%_30%,100%_100%,10%_100%,0_70%)] shadow-[0_0_20px_rgba(255,88,0,0.4)]\" data-kid=\"1-4-3\" data-name=\"whatsapp call-to-action button\" href=\"https://wa.me/yournumber\">\n<i class=\"ti ti-brand-whatsapp text-lg\" data-kid=\"1-4-3-1\" data-name=\"whatsapp icon\"></i>\n            WhatsApp\n        </a>\n</nav>\n\n<header class=\"relative min-h-screen flex flex-col justify-center px-6 md:px-24 spotlight-hero overflow-hidden\" data-kid=\"1-5\" data-name=\"hero section with spotlit background\" id=\"dark-spotlight\">\n<div class=\"max-w-6xl space-y-12 relative z-10\" data-kid=\"1-5-1\" data-name=\"hero text content container\">\n<div class=\"gsap-hero-reveal\" data-kid=\"1-5-1-1\" data-name=\"hero badge container\">\n<h1 class=\"text-7xl md:text-[12rem] font-heading font-black leading-[0.8] tracking-tighter mix-blend-difference\" data-kid=\"1-5-1-1-1\" data-name=\"hero main headline\">\n                    SISTEMAS <br data-kid=\"1-5-1-1-1-1\" data-name=\"hero headline line break\">\n<span class=\"text-[#00CCFF] drop-shadow-[0_0_40px_rgba(0,204,255,0.5)]\" data-kid=\"1-5-1-1-1-2\" data-name=\"hero agile keyword highlight\">ÁGILES</span>.<br data-kid=\"1-5-1-1-1-3\" data-name=\"hero headline line break\">\n<span class=\"text-stroke-heavy opacity-40\" data-kid=\"1-5-1-1-1-4\" data-name=\"hero ai keyword highlight\">CON IA.</span>\n</h1>\n</div>\n<p class=\"text-xl md:text-3xl text-gray-500 max-w-2xl leading-tight font-light gsap-hero-reveal\" data-kid=\"1-5-1-2\" data-name=\"hero description text\">\n                Software factory de alto rendimiento. <br data-kid=\"1-5-1-2-1\" data-name=\"hero description line break\">\n                Convertimos el desorden operacional en <span class=\"text-white border-b-2 border-[#00CCFF]\" data-kid=\"1-5-1-2-2\" data-name=\"hero precision algorithm highlight\">precisión algorítmica</span>.\n            </p>\n<div class=\"flex flex-wrap gap-8 pt-4 gsap-hero-reveal\" data-kid=\"1-5-1-3\" data-name=\"hero actions container\">\n<a class=\"px-14 py-7 bg-white text-black font-black text-xs uppercase tracking-[0.4em] hover:bg-[#00CCFF] hover:text-white transition-all duration-300 clip-path-[polygon(0_0,100%_0,100%_80%,90%_100%,0_100%)]\" data-kid=\"1-5-1-3-1\" data-name=\"hero primary cta button\" href=\"#giant-marquee\">\n                    Iniciar Auditoría\n                </a>\n<a class=\"px-14 py-7 border-2 border-white/20 text-white font-black text-xs uppercase tracking-[0.4em] hover:border-[#FF5800] transition-all duration-300 clip-path-[polygon(10%_0,100%_0,100%_100%,0_100%,0_20%)]\" data-kid=\"1-5-1-3-2\" data-name=\"hero secondary cta link\" href=\"#gsap-pin-image-text\">\n                    Success Case\n                </a>\n</div>\n</div>\n\n<div class=\"absolute right-[5%] top-1/2 -translate-y-1/2 hidden xl:block float-3d w-[550px] h-[550px] z-0\" data-kid=\"1-5-2\" data-name=\"3d floating object container\">\n<div class=\"relative w-full h-full flex items-center justify-center\" data-kid=\"1-5-2-1\" data-name=\"floating object wrapper\">\n<div class=\"absolute inset-0 bg-[#00CCFF]/10 blur-[150px] rounded-full scale-125 animate-pulse\" data-kid=\"1-5-2-1-1\" data-name=\"glowing pulse background\"></div>\n<svg class=\"relative z-10 w-full h-full drop-shadow-[0_0_80px_rgba(255,88,0,0.6)] opacity-95\" data-kid=\"1-5-2-1-2\" data-name=\"company symbol icon\" viewbox=\"0 0 200 200\">\n<defs data-kid=\"4\">\n<lineargradient id=\"grad1\" x1=\"0%\" x2=\"100%\" y1=\"0%\" y2=\"100%\" data-kid=\"5\">\n<stop offset=\"0%\" style=\"stop-color:#FF5800;stop-opacity:1\" data-kid=\"6\"></stop>\n<stop offset=\"100%\" style=\"stop-color:#FF7A33;stop-opacity:1\" data-kid=\"7\"></stop>\n</lineargradient>\n</defs>\n<path d=\"M40,70 L100,40 L160,70 L160,130 L100,160 L40,130 Z\" fill=\"url(#grad1)\" data-kid=\"8\"></path>\n<path d=\"M40,70 L100,100 L160,70 M10